Pets defined []Pet models.types
Pet struct models.types
  ID int json=id required omitempty readOnly checks=value
  Name string json=name required checks=value
  Kind string json=kind required checks=value
  Tag *string json=tag nullable omitempty checks=value?
  Age *int json=age omitempty default=1 checks=value
  Count *int json=count omitempty checks=value
  Born *string json=born omitempty readOnly checks=value
  Owner *Owner json=owner omitempty checks=Owner
  Tags []string json=tags omitempty checks=[]value
  Notes []*string json=notes omitempty checks=[]value?
