Early struct models.types
  Node *EarlyNode json=node omitempty
  Later *EarlyLater json=later omitempty
EarlyNode struct models.types
  ID *string json=id omitempty
EarlyLater struct models.types
  V *string json=v omitempty
Late struct models.types
  Inner *EarlyLater json=inner omitempty
  Same *EarlyLater json=same omitempty
Tree struct models.types
  Kids TreeKids json=kids omitempty
TreeKids defined []TreeKids models.types
Pair struct models.types
  P any json=p omitempty
  Q any json=q omitempty
Choice union models.unions
  | oneOf
  | Option1 *ChoiceOption1 kinds=object known=inline
  | Late *Late kinds=object known=inner,same
ChoiceOption1 struct models.types
  Inline *ChoiceOption1Inline json=inline omitempty
ChoiceOption1Inline struct models.types
  A *string json=a omitempty
Multi union models.unions
  | oneOf
  | String *string kinds=string
  | Int *int kinds=integer
Holder struct models.types
  Choice *HolderChoice json=choice omitempty
  List []HolderListItem json=list omitempty
HolderChoice union models.unions
  | anyOf
  | String *string kinds=string
  | Int *int kinds=integer
HolderListItem union models.unions
  | oneOf
  | String *string kinds=string
  | Bool *bool kinds=boolean
Node struct models.types
  Child *NodeChild json=child omitempty
NodeChild struct models.types
  Parent *NodeChild json=parent omitempty
GetTreeResponse200 struct models.responses
  Node *EarlyNode json=node omitempty
op GetTree GET /tree
  response 200 application/json GetTreeResponse200
---
