Parcel struct models.types
  ID string json=id required
  Doc *runtime.File json=doc omitempty
  Logo *runtime.File json=logo omitempty
  Pet *Pet json=pet omitempty
  Pets []Pet json=pets omitempty
  Labels []Pet json=labels omitempty
  Meta map[string]string json=meta omitempty
  Note *string json=note omitempty
  Tags []string json=tags omitempty
  Flags *string json=flags omitempty
  Signed *runtime.File json=signed omitempty
Pet struct models.types
  Name *string json=name omitempty
SendUnionMultipartRequestBody union models.unions form
  | oneOf
  | Parcel *Parcel kinds=object required=id known=id,doc,logo,pet,pets,labels,meta,note,tags,flags,signed
  | Option2 *SendUnionMultipartRequestBodyOption2 kinds=object required=x known=x
SendUnionMultipartRequestBodyOption2 struct models.bodies
  X string json=x required
SendUnionFormRequestBody defined map[string]string models.bodies
op SendParcel POST /parcels
  body multipart/form-data Parcel encoding=doc:application/pdf encoding=id:application/json encoding=labels:text/csv, application/vnd.a+json encoding=logo:image/png, image/jpeg encoding=meta:text/plain encoding=pet:application/xml encoding=pets:text/plain, application/* encoding=signed:application/pdf
  body application/x-www-form-urlencoded Parcel encoding=pet:application/json
