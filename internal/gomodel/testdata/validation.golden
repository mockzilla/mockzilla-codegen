  ? Contacts path=contacts response-only guarded required
  ? Pet path=pet pointer guarded nested
  ? AdditionalProperties path= guarded
  ?   values - path= nested
Labels defined map[string]int models.types
  ? validate
  ? - path= guarded maxProperties(2)
  ?   values - path= minimum(1)
Choice union models.unions
  | oneOf
  | String *string kinds=string
  | Strings []string kinds=array
  | Owner *Owner kinds=object required=contacts
  ? validate count=ExactlyOne response
  ? String path= variant pointer guarded maxLength(3)
  ? Strings path= variant guarded minItems(1)
  ? Owner path= variant pointer guarded nested
MaybeChoice union models.unions
  | anyOf nullable text
  | String *string kinds=string
  | Int *int kinds=integer
SomeChoice union models.unions
  | anyOf text
  | String *string kinds=string
  | Int *int kinds=integer
  ? validate count=AtLeastOne
NullableChoice union models.unions
  | oneOf nullable text
  | String *string kinds=string
  | Int *int kinds=integer
  ? validate count=AtMostOne
