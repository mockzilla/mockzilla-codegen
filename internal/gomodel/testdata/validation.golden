pattern patternPetName models.types "^[A-Z]" "^[A-Z]"
pattern patternPetTagsItem models.types "^[a-z]+$" "^[a-z]+$"
pattern patternPetAccent models.types "^\\u00e9" "^\\xE9"
pattern patternStrictCode models.types "^a" "^a"
pattern patternStrictCode2 models.types "z$" "z$"
pattern patternStrictWrapped models.types "b" "b"
pattern patternMergedKey models.types "b$" "b$"
