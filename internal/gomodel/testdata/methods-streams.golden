ListEventsResponseItem alias string models.responses
PollResponse200 alias string models.responses
op GetCertRequest2 GET /certs/{id}/request
op GetCert GET /certs/{id}
op ListEvents GET /events
  response 200 text/event-stream ListEventsResponseItem item ListEventsResponseItem
op ListEventsStream2 GET /events/stream
op Poll GET /polls
  response 200 application/json PollResponse200
  response 500 text/event-stream -
  response default text/event-stream -
op PollStream GET /polls/stream
op Report GET /reports
op ReportTool GET /reports/tool
op Ping GET /pings
op PingTool GET /pings/tool
op NoticeRequest GET /notices/request
op Notice POST notice
---
info name-clash 6:7 /paths/~1certs~1{id}~1request/get: "GetCertRequest" is a method of /paths/~1certs~1{id}/get, renamed to "GetCertRequest2"
info name-clash 24:7 /paths/~1events~1stream/get: "ListEventsStream" is a method of /paths/~1events/get, renamed to "ListEventsStream2"
