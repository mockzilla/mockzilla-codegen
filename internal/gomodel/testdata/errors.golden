ErrorResponse struct models.types
  Error2 *ErrorResponseError json=error omitempty
  ! error error.message constructor
ErrorResponseError struct models.types
  Message *string json=message omitempty
  Code *int json=code omitempty
  ! error code
DetailError struct models.types
  Details []DetailErrorDetailsItem json=details omitempty
  ! error details[].text constructor
DetailErrorDetailsItem struct models.types
  Text *string json=text omitempty
Problem union models.unions
  | oneOf
  | Option1 *ProblemOption1 kinds=object known=message
  | Option2 *ProblemOption2 kinds=object known=detail
  ! error detail
ProblemOption1 struct models.types
  Message *string json=message omitempty
ProblemOption2 struct models.types
  Detail *string json=detail omitempty
Plain struct models.types
  Error2 *string json=error omitempty
  ! error error constructor
Problems defined []ProblemsItem models.types
ProblemsItem struct models.types
  Text *string json=text omitempty
ListedError struct models.types
  Problems Problems json=problems omitempty
  ! error problems[].text constructor
Status enum string models.enums
  StatusA "a"
  StatusB "b"
StrictError struct models.types
  Error2 StrictErrorError json=error required
  Status int json=status required
  ! error error.message constructor unset=status,error.code
StrictErrorError struct models.types
  Message string json=message required
  Code int json=code required
StrictList struct models.types
  Items []StrictListItemsItem json=items omitempty
  ! error items[].text constructor unset=items[].kind
StrictListItemsItem struct models.types
  Text string json=text required
  Kind string json=kind required
