)

// The kinds of HandlerError.
const (
	ErrorParse      = {{.Runtime}}.ErrorParse
	ErrorDecode     = {{.Runtime}}.ErrorDecode
	ErrorValidation = {{.Runtime}}.ErrorValidation
	ErrorService    = {{.Runtime}}.ErrorService
	ErrorResponse   = {{.Runtime}}.ErrorResponse
)