// WithRouter registers the routes on r instead of a new Router.
func WithRouter(r {{.Framework}}.Router) {{.Option}} {
	return func(o *{{.Options}}) {
		o.Router = r
	}
}

// NewRouter registers every operation on a go-zero router, for rest.WithRouter.
func NewRouter(svc {{.Service}}, opts ...{{.Option}}) {{.Framework}}.Router {
	o := {{.NewOptions}}(opts...)
{{- if .Routes}}
	a := {{.NewAdapter}}(svc, opts...)
{{- end}}
	wrap := func(h {{.Packages.http}}.Handler) {{.Packages.http}}.Handler {
		for i := len(o.Middleware) - 1; i >= 0; i-- {
			h = o.Middleware[i](h)
		}
		return h
	}
	register := func(r {{.Framework}}.Router, route func({{.Packages.http}}.Handler) {{.Packages.http}}.Handler) {
{{- range .Routes}}
		handle(r, "{{.HTTPMethod}}", {{.Pattern}}, route({{$.Packages.http}}.HandlerFunc(a.{{.Operation}})))
{{- end}}
{{- override "server.router-extra" .}}
	}

	if r, _ := o.Router.({{.Framework}}.Router); r != nil {
		register(r, wrap)
		return r
	}
	r := {{.Packages.router}}.NewRouter()
	register(r, func(h {{.Packages.http}}.Handler) {{.Packages.http}}.Handler { return h })
	return wrappedRouter{Router: r, handler: wrap(r)}
}

type wrappedRouter struct {
	{{.Framework}}.Router
	handler {{.Packages.http}}.Handler
}

func (r wrappedRouter) ServeHTTP(w {{.Packages.http}}.ResponseWriter, req *{{.Packages.http}}.Request) {
	r.handler.ServeHTTP(w, req)
}

func handle(r {{.Framework}}.Router, method, path string, h {{.Packages.http}}.Handler) {
	if err := r.Handle(method, path, h); err != nil {
		// The generator checked the route, so this is a bug of the generator.
		panic(err)
	}
}
