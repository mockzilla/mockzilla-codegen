// WithRouter registers the routes on e instead of a new Engine.
func WithRouter(e *{{.Framework}}.Engine) {{.Option}} {
	return func(o *{{.Options}}) {
		o.Router = e
	}
}

// NewRouter registers every operation on a gin Engine.
func NewRouter(svc {{.Service}}, opts ...{{.Option}}) *{{.Framework}}.Engine {
	o := {{.NewOptions}}(opts...)
{{- if .Routes}}
	a := {{.NewAdapter}}(svc, opts...)
{{- end}}
	wrap := func(h {{.Packages.http}}.Handler) {{.Packages.http}}.Handler {
		for i := len(o.Middleware) - 1; i >= 0; i-- {
			h = o.Middleware[i](h)
		}
		return h
	}
	register := func(e *{{.Framework}}.Engine, route func({{.Packages.http}}.Handler) {{.Packages.http}}.Handler) {
{{- range .Routes}}
{{- if .IsShortcut}}
		e.{{.HTTPMethod}}({{.Pattern}}, handle(route({{$.Packages.http}}.HandlerFunc(a.{{.Operation}})){{range .Names}}, {{.}}{{end}}))
{{- else}}
		e.Handle("{{.HTTPMethod}}", {{.Pattern}}, handle(route({{$.Packages.http}}.HandlerFunc(a.{{.Operation}})){{range .Names}}, {{.}}{{end}}))
{{- end}}
{{- end}}
{{- override "server.router-extra" .}}
	}

	if e, _ := o.Router.(*{{.Framework}}.Engine); e != nil {
		register(e, wrap)
		return e
	}
	e := {{.Framework}}.New()
	register(e, wrap)
	e.NoRoute(handle(wrap({{.Packages.http}}.NotFoundHandler())))
	return e
}

func handle(h {{.Packages.http}}.Handler, names ...string) {{.Framework}}.HandlerFunc {
	return func(c *{{.Framework}}.Context) {
		// gin holds one name at a position for every route, so the spec's names come by position.
		for i, p := range c.Params {
			name := p.Key
			if i < len(names) {
				name = names[i]
			}
			c.Request.SetPathValue(name, p.Value)
		}
		h.ServeHTTP(c.Writer, c.Request)
	}
}
