// WithRouter registers the routes on s instead of a new Server.
func WithRouter(s *{{.Framework}}.Server) {{.Option}} {
	return func(o *{{.Options}}) {
		o.Router = s
	}
}

// NewRouter registers every operation on a GoFrame server.
func NewRouter(svc {{.Service}}, opts ...{{.Option}}) *{{.Framework}}.Server {
	o := {{.NewOptions}}(opts...)
{{- if .Routes}}
	a := {{.NewAdapter}}(svc, opts...)
{{- end}}
	wrap := func(h {{.Packages.http}}.Handler) {{.Packages.http}}.Handler {
		for i := len(o.Middleware) - 1; i >= 0; i-- {
			h = o.Middleware[i](h)
		}
		return h
	}
	register := func(s *{{.Framework}}.Server, route func({{.Packages.http}}.Handler) {{.Packages.http}}.Handler) {
{{- range .Routes}}
		s.BindHandler({{.Pattern}}, handle(route({{$.Packages.http}}.HandlerFunc(a.{{.Operation}}))))
{{- end}}
{{- override "server.router-extra" .}}
	}

	if s, _ := o.Router.(*{{.Framework}}.Server); s != nil {
		register(s, wrap)
		return s
	}
	// GoFrame keeps its servers by name, so a new one takes a fresh id.
	s := {{.Framework}}.GetServer({{.Packages.guid}}.S())
	register(s, wrap)
	s.BindStatusHandler({{.Packages.http}}.StatusNotFound, notFound(wrap({{.Packages.http}}.NotFoundHandler())))
	return s
}

func handle(h {{.Packages.http}}.Handler) {{.Framework}}.HandlerFunc {
	return func(r *{{.Framework}}.Request) {
		for name, value := range r.GetRouterMap() {
			r.Request.SetPathValue(name, value)
		}
		// Past GoFrame's buffer, so a status without a body stays without one.
		h.ServeHTTP(r.Response.Writer, r.Request)
	}
}

func notFound(h {{.Packages.http}}.Handler) {{.Framework}}.HandlerFunc {
	return func(r *{{.Framework}}.Request) {
		// GoFrame calls this for a 404 a route wrote too.
		if r.GetServeHandler() == nil {
			handle(h)(r)
		}
	}
}
