// WithRouter registers the routes on s instead of a new Server.
func WithRouter(s *{{.Framework}}.Server) {{.Option}} {
	return func(o *{{.Options}}) {
		o.Router = s
	}
}

// NewRouter registers every operation on a GoFrame server.
func NewRouter(svc {{.Service}}, opts ...{{.Option}}) *{{.Framework}}.Server {
	o := {{.NewOptions}}(opts...)
{{- if .Routes}}
	a := {{.NewAdapter}}(svc, opts...)
{{- end}}
	wrap := func(h {{.Packages.http}}.Handler) {{.Packages.http}}.Handler {
		for i := len(o.Middleware) - 1; i >= 0; i-- {
			h = o.Middleware[i](h)
		}
		return h
	}
	register := func(s *{{.Framework}}.Server, route func({{.Packages.http}}.Handler) {{.Packages.http}}.Handler) {
{{- range .Routes}}
		s.BindHandler({{.Pattern}}, handle(route(strict("{{.HTTPMethod}}", {{$.Packages.http}}.HandlerFunc(a.{{.Operation}})))))
{{- end}}
{{- override "server.router-extra" .}}
	}

	if s, _ := o.Router.(*{{.Framework}}.Server); s != nil {
		register(s, wrap)
		return s
	}
	// GoFrame keeps its servers by name, so a new one takes a fresh id.
	s := {{.Framework}}.GetServer({{.Packages.guid}}.S())
	register(s, wrap)
	s.BindStatusHandler({{.Packages.http}}.StatusNotFound, notFound(wrap({{.Packages.http}}.NotFoundHandler())))
	return s
}

func handle(h {{.Packages.http}}.Handler) {{.Framework}}.HandlerFunc {
	return func(r *{{.Framework}}.Request) {
		for name, value := range values(r) {
			r.Request.SetPathValue(name, value)
		}
		// Past GoFrame's buffer, so a status without a body stays without one.
		h.ServeHTTP(r.Response.Writer, r.Request)
	}
}

func notFound(h {{.Packages.http}}.Handler) {{.Framework}}.HandlerFunc {
	return func(r *{{.Framework}}.Request) {
		// GoFrame calls this for a 404 a route wrote too.
		if r.GetServeHandler() == nil {
			handle(h)(r)
		}
	}
}

func strict(method string, h {{.Packages.http}}.Handler) {{.Packages.http}}.Handler {
	return {{.Packages.http}}.HandlerFunc(func(w {{.Packages.http}}.ResponseWriter, r *{{.Packages.http}}.Request) {
		// GoFrame also picks a route by Access-Control-Request-Method on OPTIONS and by X-Url-Path.
		if routed := r.Header.Get("X-Url-Path"); r.Method != method || routed != "" && routed != r.URL.Path {
			{{.Packages.http}}.NotFound(w, r)
			return
		}
		h.ServeHTTP(w, r)
	})
}

func values(r *{{.Framework}}.Request) map[string]string {
	// GoFrame unescapes each value of the path it already unescaped, so they are read again here.
	if r.Router == nil {
		return r.GetRouterMap()
	}
	match, _ := {{.Packages.gregex}}.MatchString(r.Router.RegRule, r.URL.EscapedPath())
	if len(match) != len(r.Router.RegNames)+1 {
		return r.GetRouterMap()
	}
	out := make(map[string]string, len(r.Router.RegNames))
	for i, name := range r.Router.RegNames {
		out[name] = match[i+1]
		if value, err := {{.Packages.url}}.PathUnescape(match[i+1]); err == nil {
			out[name] = value
		}
	}
	return out
}
