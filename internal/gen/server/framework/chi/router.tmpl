// WithRouter registers the routes on r instead of a new router.
func WithRouter(r {{.Framework}}.Router) {{.Option}} {
	return func(o *{{.Options}}) {
		o.Router = r
	}
}

// NewRouter registers every operation on a chi router.
func NewRouter(svc {{.Service}}, opts ...{{.Option}}) {{.Framework}}.Router {
	o := {{.NewOptions}}(opts...)
{{- if .Routes}}
	adapter := {{.NewAdapter}}(svc, opts...)
{{- end}}
	register := func(r {{.Framework}}.Router) {
{{- range .Routes}}
		r.{{.Method}}({{.Pattern}}, adapter.{{.Operation}})
{{- end}}
{{- override "server.router-extra" .}}
	}

	router, _ := o.Router.({{.Framework}}.Router)
	if router == nil {
		router = {{.Framework}}.NewRouter()
		router.Use(o.Middleware...)
		register(router)
		return router
	}
	router.Group(func(r {{.Framework}}.Router) {
		r.Use(o.Middleware...)
		register(r)
	})
	return router
}