// WithRouter registers the routes on h instead of a new Hertz.
func WithRouter(h *{{.Framework}}.Hertz) {{.Option}} {
	return func(o *{{.Options}}) {
		o.Router = h
	}
}

// WithConfig makes the new Hertz with opts, such as its address and timeouts.
func WithConfig(opts ...{{.Packages.config}}.Option) {{.Option}} {
	return func(o *{{.Options}}) {
		o.Router = opts
	}
}

// NewRouter registers every operation on a Hertz server.
func NewRouter(svc {{.Service}}, opts ...{{.Option}}) *{{.Framework}}.Hertz {
	o := {{.NewOptions}}(opts...)
{{- if .Routes}}
	a := {{.NewAdapter}}(svc, opts...)
{{- end}}
	wrap := func(h {{.Packages.http}}.Handler) {{.Packages.http}}.Handler {
		for i := len(o.Middleware) - 1; i >= 0; i-- {
			h = o.Middleware[i](h)
		}
		return h
	}
	register := func(h *{{.Framework}}.Hertz, route func({{.Packages.http}}.Handler) {{.Packages.http}}.Handler) {
{{- range .Routes}}
{{- if .IsShortcut}}
		h.{{.HTTPMethod}}({{.Pattern}}, handle(route({{$.Packages.http}}.HandlerFunc(a.{{.Operation}}))))
{{- else}}
		h.Handle("{{.HTTPMethod}}", {{.Pattern}}, handle(route({{$.Packages.http}}.HandlerFunc(a.{{.Operation}}))))
{{- end}}
{{- end}}
{{- override "server.router-extra" .}}
	}

	if h, _ := o.Router.(*{{.Framework}}.Hertz); h != nil {
		register(h, wrap)
		return h
	}
	serverOpts, _ := o.Router.([]{{.Packages.config}}.Option)
	h := {{.Framework}}.New(serverOpts...)
	register(h, wrap)
	h.NoRoute(handle(wrap({{.Packages.http}}.NotFoundHandler())))
	return h
}

func handle(h {{.Packages.http}}.Handler) {{.Packages.app}}.HandlerFunc {
	return func(ctx {{.Packages.context}}.Context, c *{{.Packages.app}}.RequestContext) {
		r, err := {{.Packages.http}}.NewRequestWithContext(ctx, string(c.Method()), string(c.URI().FullURI()), {{.Packages.bytes}}.NewReader(c.Request.Body()))
		if err != nil {
			c.AbortWithMsg(err.Error(), {{.Packages.http}}.StatusBadRequest)
			return
		}
		c.Request.Header.VisitAll(func(key, value []byte) {
			r.Header.Add(string(key), string(value))
		})
		for _, p := range c.Params {
			r.SetPathValue(p.Key, p.Value)
		}
		r.RemoteAddr = c.RemoteAddr().String()
		r.RequestURI = string(c.Request.RequestURI())
		w := &responseWriter{response: &c.Response, header: {{.Packages.http}}.Header{}}
		h.ServeHTTP(w, r)
		// A handler that writes no body still sets its headers.
		if !w.isWritten {
			w.WriteHeader({{.Packages.http}}.StatusOK)
		}
	}
}

type responseWriter struct {
	response  *{{.Packages.protocol}}.Response
	header    {{.Packages.http}}.Header
	isWritten bool
}

func (w *responseWriter) Header() {{.Packages.http}}.Header {
	return w.header
}

func (w *responseWriter) WriteHeader(status int) {
	if w.isWritten {
		return
	}
	w.isWritten = true
	for key, values := range w.header {
		for _, value := range values {
			w.response.Header.Add(key, value)
		}
	}
	w.response.SetStatusCode(status)
}

func (w *responseWriter) Write(b []byte) (int, error) {
	if !w.isWritten {
		w.WriteHeader({{.Packages.http}}.StatusOK)
	}
	return w.response.BodyWriter().Write(b)
}
