// WithRouter registers the routes on r instead of a new Router.
func WithRouter(r *{{.Framework}}.Router) {{.Option}} {
	return func(o *{{.Options}}) {
		o.Router = r
	}
}

// NewRouter registers every operation on a fasthttp router.
func NewRouter(svc {{.Service}}, opts ...{{.Option}}) *{{.Framework}}.Router {
	o := {{.NewOptions}}(opts...)
{{- if .Routes}}
	adapter := {{.NewAdapter}}(svc, opts...)
{{- end}}
	wrap := func(h {{.Packages.http}}.Handler) {{.Packages.http}}.Handler {
		for i := len(o.Middleware) - 1; i >= 0; i-- {
			h = o.Middleware[i](h)
		}
		return h
	}
	register := func(r *{{.Framework}}.Router, route func({{.Packages.http}}.Handler) {{.Packages.http}}.Handler) {
{{- range .Routes}}
		r.{{.HTTPMethod}}({{.Pattern}}, handle(route({{$.Packages.http}}.HandlerFunc(adapter.{{.Operation}}))))
{{- end}}
{{- override "server.router-extra" .}}
	}

	if r, _ := o.Router.(*{{.Framework}}.Router); r != nil {
		register(r, wrap)
		return r
	}
	r := {{.Framework}}.New()
	// The router would answer OPTIONS itself, past the middleware.
	r.HandleOPTIONS = false
	register(r, wrap)
	r.NotFound = handle(wrap({{.Packages.http}}.NotFoundHandler()))
	r.MethodNotAllowed = handle(wrap({{.Packages.http}}.HandlerFunc(methodNotAllowed)))
	return r
}

func handle(h {{.Packages.http}}.Handler) {{.Packages.fasthttp}}.RequestHandler {
	return func(ctx *{{.Packages.fasthttp}}.RequestCtx) {
		{{.Packages.fasthttpadaptor}}.NewFastHTTPHandler({{.Packages.http}}.HandlerFunc(func(w {{.Packages.http}}.ResponseWriter, r *{{.Packages.http}}.Request) {
			ctx.VisitUserValues(func(key []byte, value any) {
				if s, ok := value.(string); ok {
					r.SetPathValue(string(key), s)
				}
			})
			h.ServeHTTP(w, r)
		}))(ctx)
	}
}

func methodNotAllowed(w {{.Packages.http}}.ResponseWriter, _ *{{.Packages.http}}.Request) {
	w.WriteHeader({{.Packages.http}}.StatusMethodNotAllowed)
}
