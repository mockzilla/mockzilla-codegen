// WithRouter registers the routes on s instead of a new Server.
func WithRouter(s *{{.Framework}}.Server) {{.Option}} {
	return func(o *{{.Options}}) {
		o.Router = s
	}
}

// NewRouter registers every operation on a kratos HTTP server.
func NewRouter(svc {{.Service}}, opts ...{{.Option}}) *{{.Framework}}.Server {
	o := {{.NewOptions}}(opts...)
{{- if .Routes}}
	a := {{.NewAdapter}}(svc, opts...)
{{- end}}
	filters := make([]{{.Framework}}.FilterFunc, len(o.Middleware))
	for i, mw := range o.Middleware {
		filters[i] = mw
	}
	register := func(r *{{.Framework}}.Router) {
{{- range .Routes}}
		r.{{.HTTPMethod}}({{.Pattern}}, a.{{.Operation}})
{{- end}}
{{- override "server.router-extra" .}}
	}

	if s, _ := o.Router.(*{{.Framework}}.Server); s != nil {
		register(s.Route("/", filters...))
		return s
	}
	s := {{.Framework}}.NewServer({{.Framework}}.Filter(filters...))
	register(s.Route("/"))
	return s
}
