// WithRouter registers the routes on e instead of a new Echo.
func WithRouter(e *{{.Framework}}.Echo) {{.Option}} {
	return func(o *{{.Options}}) {
		o.Router = e
	}
}

// NewRouter registers every operation on an Echo.
func NewRouter(svc {{.Service}}, opts ...{{.Option}}) *{{.Framework}}.Echo {
	o := {{.NewOptions}}(opts...)
{{- if .Routes}}
	a := {{.NewAdapter}}(svc, opts...)
{{- end}}
	middleware := make([]{{.Framework}}.MiddlewareFunc, len(o.Middleware))
	for i, mw := range o.Middleware {
		middleware[i] = {{.Framework}}.WrapMiddleware(mw)
	}
	register := func(e *{{.Framework}}.Echo, m ...{{.Framework}}.MiddlewareFunc) {
{{- range .Routes}}
		e.{{.HTTPMethod}}({{.Pattern}}, a.{{.Operation}}, m...)
{{- end}}
{{- override "server.router-extra" .}}
	}

	e, _ := o.Router.(*{{.Framework}}.Echo)
	if e == nil {
		e = {{.Framework}}.New()
		if len(middleware) > 0 {
			e.Use(append(middleware, answerErrors)...)
		}
		register(e)
		return e
	}
	register(e, middleware...)
	return e
}

func answerErrors(next {{.Framework}}.HandlerFunc) {{.Framework}}.HandlerFunc {
	return func(c *{{.Framework}}.Context) error {
		if err := next(c); err != nil {
			// Answered here, inside the middleware, so the middleware sees the response.
			c.Echo().HTTPErrorHandler(c, err)
		}
		return nil
	}
}
