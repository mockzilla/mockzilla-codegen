// WithRouter registers the routes on mux instead of a new one.
func WithRouter(mux *{{.Framework}}.ServeMux) {{.Option}} {
	return func(o *{{.Options}}) {
		o.Router = mux
	}
}

// NewRouter registers every operation on an http.ServeMux.
func NewRouter(svc {{.Service}}, opts ...{{.Option}}) {{.Framework}}.Handler {
	o := {{.NewOptions}}(opts...)
{{- if .Routes}}
	adapter := {{.NewAdapter}}(svc, opts...)
{{- end}}
	wrap := func(h {{.Framework}}.Handler) {{.Framework}}.Handler {
		for i := len(o.Middleware) - 1; i >= 0; i-- {
			h = o.Middleware[i](h)
		}
		return h
	}
	register := func(mux *{{.Framework}}.ServeMux, route func({{.Framework}}.Handler) {{.Framework}}.Handler) {
{{- range .Routes}}
		mux.Handle({{.Pattern}}, route({{$.Framework}}.HandlerFunc(adapter.{{.Operation}})))
{{- end}}
{{- override "server.router-extra" .}}
	}

	if mux, _ := o.Router.(*{{.Framework}}.ServeMux); mux != nil {
		register(mux, wrap)
		return mux
	}
	mux := {{.Framework}}.NewServeMux()
	register(mux, func(h {{.Framework}}.Handler) {{.Framework}}.Handler { return h })
	return wrap(mux)
}