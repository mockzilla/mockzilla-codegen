func main() {
	if err := run(); err != nil {
		{{.Slog}}.Error("server stopped", "error", err)
		{{.OS}}.Exit(1)
	}
}

func run() error {
	ctx, stop := {{.Signal}}.NotifyContext({{.Context}}.Background(), {{.OS}}.Interrupt, {{.Syscall}}.SIGTERM)
	defer stop()

	app := {{.NewRouter}}({{.NewService}}(), {{.WithConfig}}({{.Framework}}.Config{ReadTimeout: {{.Timeout}}}){{if .Middleware}}, {{.WithMiddleware}}(
{{- range .Middleware}}
		{{.}},
{{- end}}
	){{end}})

	errs := make(chan error, 1)
	go func() {
		{{.Slog}}.Info("listening", "addr", ":{{.Port}}")
		errs <- app.Listen(":{{.Port}}", {{.Framework}}.ListenConfig{DisableStartupMessage: true})
	}()

	select {
	case err := <-errs:
		return err
	case <-ctx.Done():
	}
	return app.ShutdownWithTimeout({{.Timeout}})
}
