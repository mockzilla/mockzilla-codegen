// WithRouter registers the routes on app instead of a new App.
func WithRouter(app *{{.Framework}}.App) {{.Option}} {
	return func(o *{{.Options}}) {
		o.Router = app
	}
}

// WithConfig makes the new App with cfg.
func WithConfig(cfg {{.Framework}}.Config) {{.Option}} {
	return func(o *{{.Options}}) {
		o.Router = cfg
	}
}

// NewRouter registers every operation on a fiber App.
func NewRouter(svc {{.Service}}, opts ...{{.Option}}) *{{.Framework}}.App {
	o := {{.NewOptions}}(opts...)
{{- if .Routes}}
	a := {{.NewAdapter}}(svc, opts...)
{{- end}}
	wrap := func(h {{.Packages.http}}.Handler) {{.Packages.http}}.Handler {
		for i := len(o.Middleware) - 1; i >= 0; i-- {
			h = o.Middleware[i](h)
		}
		// fasthttp would end the process on a panic.
		return {{.Runtime}}.Recover(h, o.ErrorHandler)
	}
	register := func(app *{{.Framework}}.App, route func({{.Packages.http}}.Handler) {{.Packages.http}}.Handler) {
{{- range .Routes}}
		app.{{.Method}}({{.Pattern}}, handle(route({{$.Packages.http}}.HandlerFunc(a.{{.Operation}}))))
{{- end}}
{{- override "server.router-extra" .}}
	}

	if app, _ := o.Router.(*{{.Framework}}.App); app != nil {
		register(app, wrap)
		return app
	}
	cfg, _ := o.Router.({{.Framework}}.Config)
	answer := cfg.ErrorHandler
	if answer == nil {
		answer = {{.Framework}}.DefaultErrorHandler
	}
	notFound := handle(wrap({{.Packages.http}}.NotFoundHandler()))
	methodNotAllowed := handle(wrap({{.Packages.http}}.HandlerFunc(func(w {{.Packages.http}}.ResponseWriter, _ *{{.Packages.http}}.Request) {
		w.WriteHeader({{.Packages.http}}.StatusMethodNotAllowed)
	})))
	// Answered from the error handler, so that a route added later is still served.
	cfg.ErrorHandler = func(c {{.Framework}}.Ctx, err error) error {
		var e *{{.Framework}}.Error
		switch {
		case !{{.Packages.errors}}.As(err, &e):
		case e.Code == {{.Framework}}.StatusNotFound:
			return notFound(c)
		case e.Code == {{.Framework}}.StatusMethodNotAllowed:
			return methodNotAllowed(c)
		}
		return answer(c, err)
	}
	app := {{.Framework}}.New(cfg)
	register(app, wrap)
	return app
}

func handle(h {{.Packages.http}}.Handler) {{.Framework}}.Handler {
	return func(c {{.Framework}}.Ctx) error {
		isEscaped := !c.App().Config().UnescapePath
		{{.Packages.fasthttpadaptor}}.NewFastHTTPHandler({{.Packages.http}}.HandlerFunc(func(w {{.Packages.http}}.ResponseWriter, r *{{.Packages.http}}.Request) {
			// fiber reuses the memory of the request's strings for the next request.
			r = {{.Runtime}}.DetachRequest(r)
			for _, name := range c.Route().Params {
				if isEscaped {
					r.SetPathValue(name, {{.Runtime}}.DetachPathValue(c.Params(name)))
				} else {
					r.SetPathValue(name, {{.Packages.strings}}.Clone(c.Params(name)))
				}
			}
			h.ServeHTTP(w, r)
		}))(c.RequestCtx())
		return nil
	}
}
