type routerKey struct{}

// WithRouter registers the routes on app instead of a new Application. The caller builds app.
func WithRouter(app *{{.Framework}}.Application) {{.Option}} {
	return func(o *{{.Options}}) {
		o.Router = app
	}
}

// NewRouter registers every operation on an iris Application.
func NewRouter(svc {{.Service}}, opts ...{{.Option}}) *{{.Framework}}.Application {
	o := {{.NewOptions}}(opts...)
{{- if .Routes}}
	a := {{.NewAdapter}}(svc, opts...)
{{- end}}
	wrap := func(h {{.Packages.http}}.Handler) {{.Packages.http}}.Handler {
		for i := len(o.Middleware) - 1; i >= 0; i-- {
			h = o.Middleware[i](h)
		}
		return h
	}
	register := func(app *{{.Framework}}.Application, route func({{.Packages.http}}.Handler) {{.Packages.http}}.Handler) {
{{- range .Routes}}
		app.{{.Method}}({{.Pattern}}, handle(route({{$.Packages.http}}.HandlerFunc(a.{{.Operation}}))))
{{- end}}
{{- override "server.router-extra" .}}
	}

	if app, _ := o.Router.(*{{.Framework}}.Application); app != nil {
		register(app, wrap)
		return app
	}
	app := {{.Framework}}.New()
	app.Configure({{.Framework}}.WithoutAutoFireStatusCode)
	// The router comes with the request, so the middleware is set up once and follows a refresh.
	routed := wrap({{.Packages.http}}.HandlerFunc(func(w {{.Packages.http}}.ResponseWriter, r *{{.Packages.http}}.Request) {
		r.Context().Value(routerKey{}).({{.Packages.http}}.HandlerFunc)(w, r)
	}))
	app.WrapRouter(func(w {{.Packages.http}}.ResponseWriter, r *{{.Packages.http}}.Request, router {{.Packages.http}}.HandlerFunc) {
		routed.ServeHTTP(w, r.WithContext({{.Packages.context}}.WithValue(r.Context(), routerKey{}, router)))
	})
	register(app, func(h {{.Packages.http}}.Handler) {{.Packages.http}}.Handler { return h })
	if err := app.Build(); err != nil {
		panic(err)
	}
	return app
}

func handle(h {{.Packages.http}}.Handler) {{.Framework}}.Handler {
	return func(c {{.Framework}}.Context) {
		r := c.Request()
		c.Params().Visit(func(name, value string) {
			r.SetPathValue(name, value)
		})
		h.ServeHTTP(c.ResponseWriter(), r)
	}
}
