package api

import echo "github.com/labstack/echo/v5"

// WithRouter registers the routes on e instead of a new Echo.
func WithRouter(e *echo.Echo) ServerOption {
	return func(o *ServerOptions) {
		o.Router = e
	}
}

// NewRouter registers every operation on an Echo.
func NewRouter(svc PetsInterface, opts ...ServerOption) *echo.Echo {
	o := NewServerOptions(opts...)
	a := NewHTTPAdapter(svc, opts...)
	middleware := make([]echo.MiddlewareFunc, len(o.Middleware))
	for i, mw := range o.Middleware {
		middleware[i] = echo.WrapMiddleware(mw)
	}
	register := func(e *echo.Echo, m ...echo.MiddlewareFunc) {
		e.GET("/pets", a.ListPets, m...)
		e.POST("/pets", a.CreatePet, m...)
		e.DELETE("/pets/:id", a.DeletePet, m...)
		e.GET("/ping", a.Ping, m...)
	}

	e, _ := o.Router.(*echo.Echo)
	if e == nil {
		e = echo.New()
		if len(middleware) > 0 {
			e.Use(append(middleware, answerErrors)...)
		}
		register(e)
		return e
	}
	register(e, middleware...)
	return e
}

func answerErrors(next echo.HandlerFunc) echo.HandlerFunc {
	return func(c *echo.Context) error {
		if err := next(c); err != nil {
			// Answered here, inside the middleware, so the middleware sees the response.
			c.Echo().HTTPErrorHandler(c, err)
		}
		return nil
	}
}
