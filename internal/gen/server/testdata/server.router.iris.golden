package api

import (
	"context"
	"net/http"

	iris "github.com/kataras/iris/v12"
)

type routerKey struct{}

// WithRouter registers the routes on app instead of a new Application. The caller builds app.
func WithRouter(app *iris.Application) ServerOption {
	return func(o *ServerOptions) {
		o.Router = app
	}
}

// NewRouter registers every operation on an iris Application.
func NewRouter(svc PetsInterface, opts ...ServerOption) *iris.Application {
	o := NewServerOptions(opts...)
	a := NewHTTPAdapter(svc, opts...)
	wrap := func(h http.Handler) http.Handler {
		for i := len(o.Middleware) - 1; i >= 0; i-- {
			h = o.Middleware[i](h)
		}
		return h
	}
	register := func(app *iris.Application, route func(http.Handler) http.Handler) {
		app.Get("/pets", handle(route(http.HandlerFunc(a.ListPets))))
		app.Post("/pets", handle(route(http.HandlerFunc(a.CreatePet))))
		app.Delete("/pets/{id}", handle(route(http.HandlerFunc(a.DeletePet))))
		app.Get("/ping", handle(route(http.HandlerFunc(a.Ping))))
	}

	if app, _ := o.Router.(*iris.Application); app != nil {
		register(app, wrap)
		return app
	}
	app := iris.New()
	app.Configure(iris.WithoutAutoFireStatusCode)
	// The router comes with the request, so the middleware is set up once and follows a refresh.
	routed := wrap(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		r.Context().Value(routerKey{}).(http.HandlerFunc)(w, r)
	}))
	app.WrapRouter(func(w http.ResponseWriter, r *http.Request, router http.HandlerFunc) {
		routed.ServeHTTP(w, r.WithContext(context.WithValue(r.Context(), routerKey{}, router)))
	})
	register(app, func(h http.Handler) http.Handler { return h })
	if err := app.Build(); err != nil {
		panic(err)
	}
	return app
}

func handle(h http.Handler) iris.Handler {
	return func(c iris.Context) {
		r := c.Request()
		c.Params().Visit(func(name, value string) {
			r.SetPathValue(name, value)
		})
		h.ServeHTTP(c.ResponseWriter(), r)
	}
}
