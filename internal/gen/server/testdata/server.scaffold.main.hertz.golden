package main

import (
	"context"
	"log/slog"
	"os"
	"os/signal"
	"syscall"
	"time"

	"example.com/work/api"
	"example.com/work/mw"
	"example.com/work/svc"
	"github.com/cloudwego/hertz/pkg/app/server"
)

func main() {
	if err := run(); err != nil {
		slog.Error("server stopped", "error", err)
		os.Exit(1)
	}
}

func run() error {
	ctx, stop := signal.NotifyContext(context.Background(), os.Interrupt, syscall.SIGTERM)
	defer stop()

	h := api.NewRouter(svc.NewPets(), api.WithConfig(server.WithHostPorts(":9090"), server.WithReadTimeout(45*time.Second)), api.WithMiddleware(
		mw.RequestIDMiddleware,
		mw.RecoverMiddleware,
		mw.LoggingMiddleware,
		mw.CORSMiddleware,
		mw.TimeoutMiddleware(45*time.Second),
	))

	errs := make(chan error, 1)
	go func() {
		slog.Info("listening", "addr", ":9090")
		errs <- h.Run()
	}()

	select {
	case err := <-errs:
		return err
	case <-ctx.Done():
	}
	shutdownCtx, cancel := context.WithTimeout(context.Background(), 45*time.Second)
	defer cancel()
	return h.Shutdown(shutdownCtx)
}
