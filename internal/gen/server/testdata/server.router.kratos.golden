package api

import khttp "github.com/go-kratos/kratos/v2/transport/http"

// WithRouter registers the routes on s instead of a new Server.
func WithRouter(s *khttp.Server) ServerOption {
	return func(o *ServerOptions) {
		o.Router = s
	}
}

// NewRouter registers every operation on a kratos HTTP server. On a new server the middleware
// WithMiddleware adds wraps everything as the server's filters, unknown paths too; on the server
// WithRouter gives it, the middleware wraps each generated route as its filters and nothing
// else.
func NewRouter(svc PetsInterface, opts ...ServerOption) *khttp.Server {
	o := NewServerOptions(opts...)
	adapter := NewHTTPAdapter(svc, opts...)
	filters := make([]khttp.FilterFunc, len(o.Middleware))
	for i, mw := range o.Middleware {
		filters[i] = mw
	}
	register := func(r *khttp.Router) {
		r.GET("/pets", adapter.ListPets)
		r.POST("/pets", adapter.CreatePet)
		r.GET("/ping", adapter.Ping)
		r.DELETE("/pets/{id}", adapter.DeletePet)
	}

	if s, _ := o.Router.(*khttp.Server); s != nil {
		register(s.Route("/", filters...))
		return s
	}
	s := khttp.NewServer(khttp.Filter(filters...))
	register(s.Route("/"))
	return s
}
