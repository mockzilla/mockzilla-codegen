package main

import (
	"context"
	"log/slog"
	"os"
	"os/signal"
	"syscall"
	"time"

	"example.com/work/api"
	"example.com/work/mw"
	"example.com/work/svc"
	fiber "github.com/gofiber/fiber/v3"
)

func main() {
	if err := run(); err != nil {
		slog.Error("server stopped", "error", err)
		os.Exit(1)
	}
}

func run() error {
	ctx, stop := signal.NotifyContext(context.Background(), os.Interrupt, syscall.SIGTERM)
	defer stop()

	app := api.NewRouter(svc.NewPets(), api.WithConfig(fiber.Config{ReadTimeout: 45 * time.Second}), api.WithMiddleware(
		mw.RequestIDMiddleware,
		mw.RecoverMiddleware,
		mw.LoggingMiddleware,
		mw.CORSMiddleware,
		mw.TimeoutMiddleware(45*time.Second),
	))

	errs := make(chan error, 1)
	go func() {
		slog.Info("listening", "addr", ":9090")
		errs <- app.Listen(":9090", fiber.ListenConfig{DisableStartupMessage: true})
	}()

	select {
	case err := <-errs:
		return err
	case <-ctx.Done():
	}
	return app.ShutdownWithTimeout(45 * time.Second)
}
