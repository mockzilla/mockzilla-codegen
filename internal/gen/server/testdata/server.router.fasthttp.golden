package api

import (
	"net/http"

	"github.com/fasthttp/router"
	"github.com/mockzilla/mockzilla-codegen/pkg/runtime"
	"github.com/valyala/fasthttp"
	"github.com/valyala/fasthttp/fasthttpadaptor"
)

// WithRouter registers the routes on r instead of a new Router.
func WithRouter(r *router.Router) ServerOption {
	return func(o *ServerOptions) {
		o.Router = r
	}
}

// NewRouter registers every operation on a fasthttp router.
func NewRouter(svc PetsInterface, opts ...ServerOption) *router.Router {
	o := NewServerOptions(opts...)
	a := NewHTTPAdapter(svc, opts...)
	wrap := func(h http.Handler) http.Handler {
		for i := len(o.Middleware) - 1; i >= 0; i-- {
			h = o.Middleware[i](h)
		}
		// fasthttp would end the process on a panic.
		return runtime.Recover(h, o.ErrorHandler)
	}
	register := func(r *router.Router, route func(http.Handler) http.Handler) {
		r.GET("/pets", handle(route(http.HandlerFunc(a.ListPets))))
		r.POST("/pets", handle(route(http.HandlerFunc(a.CreatePet))))
		r.DELETE("/pets/{id}", handle(route(http.HandlerFunc(a.DeletePet))))
		r.GET("/ping", handle(route(http.HandlerFunc(a.Ping))))
	}

	if r, _ := o.Router.(*router.Router); r != nil {
		register(r, wrap)
		return r
	}
	r := router.New()
	// The router would answer OPTIONS itself, past the middleware.
	r.HandleOPTIONS = false
	register(r, wrap)
	r.NotFound = handle(wrap(http.NotFoundHandler()))
	r.MethodNotAllowed = handle(wrap(http.HandlerFunc(methodNotAllowed)))
	return r
}

func handle(h http.Handler) fasthttp.RequestHandler {
	return func(ctx *fasthttp.RequestCtx) {
		fasthttpadaptor.NewFastHTTPHandler(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
			// fasthttp reuses the memory of the request's strings for the next request.
			r = runtime.DetachRequest(r)
			ctx.VisitUserValues(func(key []byte, value any) {
				if s, ok := value.(string); ok {
					r.SetPathValue(string(key), runtime.DetachPathValue(s))
				}
			})
			h.ServeHTTP(w, r)
		}))(ctx)
	}
}

func methodNotAllowed(w http.ResponseWriter, _ *http.Request) {
	w.WriteHeader(http.StatusMethodNotAllowed)
}
