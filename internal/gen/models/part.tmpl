{{- with .Patterns}}
var (
{{- range .}}
	{{.Name}} = {{.Regexp}}.MustCompile({{.Source}})
{{- end}}
)
{{end}}
{{- range .Decls}}
{{with .Doc}}{{comment .}}
{{end}}
{{- if .IsStruct}}{{template "models/struct.tmpl" .}}
{{- else if .IsUnion}}{{template "models/union.tmpl" .}}
{{- else if .IsEnum}}{{template "models/enum.tmpl" .}}
{{- else if .IsAlias}}{{template "models/alias.tmpl" .}}
{{- else}}{{template "models/defined.tmpl" .}}
{{- end}}
{{if .Additional}}{{template "models/additional.tmpl" .}}
{{end}}
{{- if .Validate}}{{template "models/validate.tmpl" .}}
{{end}}
{{- if .Error}}{{template "models/error.tmpl" .}}
{{end}}
{{- end}}