package api

import (
	"regexp"

	"github.com/mockzilla/mockzilla-codegen/pkg/runtime"
	"github.com/mockzilla/mockzilla-codegen/pkg/runtime/validation"
)

var (
	patternPetCode = regexp.MustCompile(`^[A-Z][^\n\r\x{2028}\x{2029}]$`)
)

type Owner struct {
	ID string `json:"id"`
}

// Validate checks the value against the constraints of the spec, as a request carries it.
func (o Owner) Validate() error {
	return nil
}

// ValidateResponse checks the value against the constraints of the spec, as a response carries it.
func (o Owner) ValidateResponse() error {
	var errs validation.Errors
	errs.Append("id", validation.Format(o.ID, "uuid"))
	return errs.Err()
}

type Empty struct{}

// Validate checks the value against the constraints of the spec.
func (e Empty) Validate() error {
	return nil
}

type Pet struct {
	Name   string            `json:"name"`
	Code   *string           `json:"code"`
	Weight float64           `json:"weight"`
	Tags   []string          `json:"tags"`
	Grid   [][]float64       `json:"grid"`
	Labels map[string]string `json:"labels"`
	Owner  *Owner            `json:"owner"`
	Secret string            `json:"secret"`
	Photo  []byte            `json:"photo"`
	Extra  map[string]any    `json:"extra"`
}

// Validate checks the value against the constraints of the spec, as a request carries it.
func (p Pet) Validate() error {
	var errs validation.Errors
	errs.Append("name", validation.MinLength(p.Name, 1))
	errs.Append("name", validation.MaxLength(p.Name, 9))
	errs.Append("name", validation.Const(p.Name, "Rex"))
	if p.Code != nil {
		errs.Append("code", validation.Pattern(*p.Code, patternPetCode, `^[A-Z].$`))
	}
	errs.Append("weight", validation.Minimum(p.Weight, 0, true))
	errs.Append("weight", validation.Maximum(p.Weight, 9.5, false))
	errs.Append("weight", validation.MultipleOf(p.Weight, 0.5))
	if p.Tags == nil {
		errs.Required("tags")
	}
	if p.Tags != nil {
		errs.Append("tags", validation.MinItems(p.Tags, 1))
		errs.Append("tags", validation.MaxItems(p.Tags, 3))
		errs.Append("tags", validation.Unique(p.Tags))
	}
	if p.Grid != nil {
		errs.Append("grid", validation.UniqueJSON(p.Grid))
		for idx, item := range p.Grid {
			for idx2, item2 := range item {
				errs.Append(validation.Index(validation.Index("grid", idx), idx2), validation.Minimum(item2, 0, false))
			}
		}
	}
	if p.Labels != nil {
		errs.Append("labels", validation.MinProperties(p.Labels, 1))
		errs.Append("labels", validation.MaxProperties(p.Labels, 2))
		for _, key := range validation.SortedKeys(p.Labels) {
			errs.Append(validation.Key("labels", key), validation.Pattern(key, patternPetCode, `^[A-Z].$`))
			errs.Append(validation.Key("labels", key), validation.Enum(key, "A", "B"))
			item := p.Labels[key]
			errs.Append(validation.Key("labels", key), validation.MinLength(item, 1))
		}
	}
	if p.Owner != nil {
		errs.Append("owner", p.Owner.Validate())
	}
	errs.Append("secret", validation.MinLength(p.Secret, 8))
	if p.Photo != nil {
		errs.Append("photo", validation.MaxLength(validation.Base64(p.Photo), 8))
		errs.Append("photo", validation.Pattern(validation.Base64(p.Photo), patternPetCode, `^[A-Z].$`))
	}
	for _, key := range validation.SortedKeys(p.Extra) {
		errs.Append(validation.Key("extra", key), validation.MaxLength(key, 4))
	}
	return errs.Err()
}

// ValidateResponse checks the value against the constraints of the spec, as a response carries it.
func (p Pet) ValidateResponse() error {
	var errs validation.Errors
	errs.Append("name", validation.MinLength(p.Name, 1))
	errs.Append("name", validation.MaxLength(p.Name, 9))
	errs.Append("name", validation.Const(p.Name, "Rex"))
	if p.Code != nil {
		errs.Append("code", validation.Pattern(*p.Code, patternPetCode, `^[A-Z].$`))
	}
	errs.Append("weight", validation.Minimum(p.Weight, 0, true))
	errs.Append("weight", validation.Maximum(p.Weight, 9.5, false))
	errs.Append("weight", validation.MultipleOf(p.Weight, 0.5))
	if p.Tags == nil {
		errs.Required("tags")
	}
	if p.Tags != nil {
		errs.Append("tags", validation.MinItems(p.Tags, 1))
		errs.Append("tags", validation.MaxItems(p.Tags, 3))
		errs.Append("tags", validation.Unique(p.Tags))
	}
	if p.Grid != nil {
		errs.Append("grid", validation.UniqueJSON(p.Grid))
		for idx, item := range p.Grid {
			for idx2, item2 := range item {
				errs.Append(validation.Index(validation.Index("grid", idx), idx2), validation.Minimum(item2, 0, false))
			}
		}
	}
	if p.Labels != nil {
		errs.Append("labels", validation.MinProperties(p.Labels, 1))
		errs.Append("labels", validation.MaxProperties(p.Labels, 2))
		for _, key := range validation.SortedKeys(p.Labels) {
			errs.Append(validation.Key("labels", key), validation.Pattern(key, patternPetCode, `^[A-Z].$`))
			errs.Append(validation.Key("labels", key), validation.Enum(key, "A", "B"))
			item := p.Labels[key]
			errs.Append(validation.Key("labels", key), validation.MinLength(item, 1))
		}
	}
	if p.Owner != nil {
		errs.Append("owner", p.Owner.ValidateResponse())
	}
	if p.Photo != nil {
		errs.Append("photo", validation.MaxLength(validation.Base64(p.Photo), 8))
		errs.Append("photo", validation.Pattern(validation.Base64(p.Photo), patternPetCode, `^[A-Z].$`))
	}
	for _, key := range validation.SortedKeys(p.Extra) {
		errs.Append(validation.Key("extra", key), validation.MaxLength(key, 4))
	}
	return errs.Err()
}

type Pets []Pet

// Validate checks the value against the constraints of the spec, as a request carries it.
func (p Pets) Validate() error {
	var errs validation.Errors
	errs.Append("", validation.MaxItems(p, 2))
	for idx, item := range p {
		errs.Append(validation.Index("", idx), item.Validate())
	}
	return errs.Err()
}

// ValidateResponse checks the value against the constraints of the spec, as a response carries it.
func (p Pets) ValidateResponse() error {
	var errs validation.Errors
	errs.Append("", validation.MaxItems(p, 2))
	for idx, item := range p {
		errs.Append(validation.Index("", idx), item.ValidateResponse())
	}
	return errs.Err()
}

type Corner struct{}

// Validate checks the value against the constraints of the spec.
func (c Corner) Validate() error {
	var errs validation.Errors
	errs.Append("", validation.EnumJSON(c, `[1]`, "{\"a\":\"x`y\"}"))
	return errs.Err()
}

type Patch struct {
	Nick   runtime.Nullable[string]    `json:"nick,omitzero"`
	Boss   runtime.Nullable[Owner]     `json:"boss,omitzero"`
	Scores []runtime.Nullable[float64] `json:"scores"`
	Names  runtime.Nullable[[]string]  `json:"names,omitzero"`
}

// Validate checks the value against the constraints of the spec, as a request carries it.
func (p Patch) Validate() error {
	var errs validation.Errors
	errs.Append("nick", validation.NotNull(p.Nick))
	if value, ok := p.Nick.Get(); ok {
		errs.Append("nick", validation.MinLength(value, 1))
	}
	if value, ok := p.Boss.Get(); ok {
		errs.Append("boss", value.Validate())
	}
	for idx, item := range p.Scores {
		if value2, ok2 := item.Get(); ok2 {
			errs.Append(validation.Index("scores", idx), validation.Minimum(value2, 0, false))
		}
	}
	if value, ok := p.Names.Get(); ok {
		for idx, item := range value {
			errs.Append(validation.Index("names", idx), validation.MinLength(item, 1))
		}
	}
	return errs.Err()
}

// ValidateResponse checks the value against the constraints of the spec, as a response carries it.
func (p Patch) ValidateResponse() error {
	var errs validation.Errors
	errs.Append("nick", validation.NotNull(p.Nick))
	if value, ok := p.Nick.Get(); ok {
		errs.Append("nick", validation.MinLength(value, 1))
	}
	if value, ok := p.Boss.Get(); ok {
		errs.Append("boss", value.ValidateResponse())
	}
	for idx, item := range p.Scores {
		if value2, ok2 := item.Get(); ok2 {
			errs.Append(validation.Index("scores", idx), validation.Minimum(value2, 0, false))
		}
	}
	if value, ok := p.Names.Get(); ok {
		for idx, item := range value {
			errs.Append(validation.Index("names", idx), validation.MinLength(item, 1))
		}
	}
	return errs.Err()
}

type Problem struct {
	Message string `json:"message"`
}

// Error returns the message at message.
func (p Problem) Error() string {
	return runtime.ErrorMessage(p, "message", "Problem")
}

// NewProblem returns a Problem with message at message.
func NewProblem(message string) Problem {
	var p Problem
	_ = runtime.SetErrorMessage(&p, "message", message)
	return p
}

type Status string

const (
	StatusOn  Status = "on"
	StatusOff Status = "off"
)

// Validate checks the value against the constraints of the spec.
func (s Status) Validate() error {
	return validation.Enum(s, StatusOn, StatusOff)
}

// Choice is one of Status or Number.
type Choice struct {
	Status *Status  `json:"-"`
	Number *float64 `json:"-"`
}

// MarshalJSON writes the variant that is set.
func (c Choice) MarshalJSON() ([]byte, error) {
	var set []any
	if c.Status != nil {
		set = append(set, c.Status)
	}
	if c.Number != nil {
		set = append(set, c.Number)
	}
	return runtime.MarshalOneOf(nil, set...)
}

// UnmarshalJSON sets the variant data matches.
func (c *Choice) UnmarshalJSON(data []byte) error {
	*c = Choice{}
	return runtime.UnmarshalUnion(data, runtime.Union{
		Variants: []runtime.Variant{
			{
				Name: "Status",
				Kind: runtime.KindString,
				Into: runtime.Into(&c.Status),
			},
			{
				Name: "Number",
				Kind: runtime.KindNumber,
				Into: runtime.Into(&c.Number),
			},
		},
	})
}

// Validate checks the value against the constraints of the spec.
func (c Choice) Validate() error {
	var errs validation.Errors
	errs.Append("", validation.ExactlyOne(c.Status != nil, c.Number != nil))
	if c.Status != nil {
		errs.Append("", c.Status.Validate())
	}
	return errs.Err()
}

// Error returns the message at detail.
func (c Choice) Error() string {
	return runtime.ErrorMessage(c, "detail", "Choice")
}

// Tagged is one of Owner or Empty.
type Tagged struct {
	Owner *Owner `json:"-"`
	Empty *Empty `json:"-"`
}

// MarshalJSON writes the variant that is set, with the discriminator value that picks it.
func (t Tagged) MarshalJSON() ([]byte, error) {
	return runtime.MarshalTagged(nil, t.union(), t.Owner, t.Empty)
}

// UnmarshalJSON sets the variant data matches.
func (t *Tagged) UnmarshalJSON(data []byte) error {
	*t = Tagged{}
	return runtime.UnmarshalUnion(data, t.union())
}

func (t *Tagged) union() runtime.Union {
	return runtime.Union{
		Discriminator: "kind",
		Shared:        []string{"kind"},
		Variants: []runtime.Variant{
			{
				Name:   "Owner",
				Kind:   runtime.KindObject,
				Values: []string{"owner"},
				Into:   runtime.Into(&t.Owner),
			},
			{
				Name:   "Empty",
				Kind:   runtime.KindObject,
				Values: []string{"empty"},
				Into:   runtime.Into(&t.Empty),
			},
		},
	}
}

// Validate checks the value against the constraints of the spec.
func (t Tagged) Validate() error {
	var errs validation.Errors
	errs.Append("", validation.ExactlyOne(t.Owner != nil, t.Empty != nil))
	errs.Append("", runtime.DiscriminatorError(t.MarshalJSON()))
	return errs.Err()
}

// Either is any of Number, Code or Tags.
type Either struct {
	Number *float64 `json:"-"`
	Code   *string  `json:"-"`
	Tags   []string `json:"-"`
}

// MarshalJSON writes the variants that are set, merged.
func (e Either) MarshalJSON() ([]byte, error) {
	var set []any
	if e.Number != nil {
		set = append(set, e.Number)
	}
	if e.Code != nil {
		set = append(set, e.Code)
	}
	if e.Tags != nil {
		set = append(set, e.Tags)
	}
	return runtime.MarshalUnion(nil, set...)
}

// UnmarshalJSON sets every variant data matches.
func (e *Either) UnmarshalJSON(data []byte) error {
	*e = Either{}
	return runtime.UnmarshalUnion(data, runtime.Union{
		IsAnyOf: true,
		Variants: []runtime.Variant{
			{
				Name: "Number",
				Kind: runtime.KindNumber,
				Into: runtime.Into(&e.Number),
			},
			{
				Name: "Code",
				Kind: runtime.KindString,
				Into: runtime.Into(&e.Code),
			},
			{
				Name: "Tags",
				Kind: runtime.KindArray,
				Into: runtime.Into(&e.Tags),
			},
		},
	})
}

// Validate checks the value against the constraints of the spec.
func (e Either) Validate() error {
	var errs validation.Errors
	errs.Append("", validation.AtLeastOne(e.Number != nil, e.Code != nil, e.Tags != nil))
	var errsCode validation.Errors
	if e.Code != nil {
		errsCode.Append("", validation.MaxLength(*e.Code, 5))
	}
	var errsTags validation.Errors
	if e.Tags != nil {
		errsTags.Append("", validation.MinItems(e.Tags, 1))
		for idx, item := range e.Tags {
			errsTags.Append(validation.Index("", idx), validation.MinLength(item, 1))
		}
	}
	errs.Append("", validation.AnyValid(
		validation.VariantErrors{IsSet: e.Number != nil},
		validation.VariantErrors{IsSet: e.Code != nil, Errs: errsCode},
		validation.VariantErrors{IsSet: e.Tags != nil, Errs: errsTags},
	))
	return errs.Err()
}
