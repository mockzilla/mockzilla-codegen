package api

import (
	"log/slog"
	"regexp"

	"github.com/mockzilla/mockzilla-codegen/pkg/runtime"
	"github.com/mockzilla/mockzilla-codegen/pkg/runtime/mask"
)

var (
	patternUserSsn = regexp.MustCompile(`\d`)
)

type Contact struct {
	Email string `json:"email"`
}

// Masked returns a copy with the sensitive values masked. JSON encoding is left as it is.
func (c Contact) Masked() Contact {
	c.Email = mask.Full(c.Email)
	return c
}

// LogValue gives slog the masked value, so logs do not show sensitive values.
func (c Contact) LogValue() slog.Value {
	return runtime.LogValue(c.Masked())
}

// Deprecated: Use Account.
type User struct {
	Password *string            `json:"password"`
	Ssn      string             `json:"ssn"`
	Token    string             `json:"token"`
	Card     string             `json:"card"`
	Pin      int                `json:"pin"`
	Main     *Contact           `json:"main"`
	Plain    Contact            `json:"plain"`
	List     []Contact          `json:"list"`
	ByName   map[string]Contact `json:"byName"`
	// Deprecated: Use Password.
	Old    string                      `json:"old"`
	Hidden string                      `json:"-"`
	Nick   runtime.Nullable[string]    `json:"nick"`
	Backup runtime.Nullable[Contact]   `json:"backup"`
	Others runtime.Nullable[[]Contact] `json:"others"`
	Code   runtime.Nullable[int]       `json:"code"`
}

// Masked returns a copy with the sensitive values masked. JSON encoding is left as it is.
func (u User) Masked() User {
	if u.Password != nil {
		u.Password = runtime.Ptr(mask.Full(*u.Password))
	}
	u.Ssn = mask.Regex(u.Ssn, patternUserSsn)
	u.Token = mask.Hash(u.Token)
	u.Card = mask.Partial(u.Card, 1, 4)
	u.Pin = mask.Zero(u.Pin)
	if u.Main != nil {
		u.Main = runtime.Ptr(u.Main.Masked())
	}
	u.Plain = u.Plain.Masked()
	u.List = mask.Slice(u.List)
	u.ByName = mask.Map(u.ByName)
	if value, ok := u.Nick.Get(); ok {
		u.Nick = runtime.Some(mask.Full(value))
	}
	if value, ok := u.Backup.Get(); ok {
		u.Backup = runtime.Some(value.Masked())
	}
	if value, ok := u.Others.Get(); ok {
		u.Others = runtime.Some(mask.Slice(value))
	}
	u.Code = mask.Zero(u.Code)
	return u
}

// LogValue gives slog the masked value, so logs do not show sensitive values.
func (u User) LogValue() slog.Value {
	return runtime.LogValue(u.Masked())
}

type Contacts []Contact

// Masked returns a copy with the sensitive values masked. JSON encoding is left as it is.
func (c Contacts) Masked() Contacts {
	c = mask.Slice(c)
	return c
}

// LogValue gives slog the masked value, so logs do not show sensitive values.
func (c Contacts) LogValue() slog.Value {
	return runtime.LogValue(c.Masked())
}
