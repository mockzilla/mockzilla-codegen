package api

import (
	"encoding/json"
	"mime/multipart"
	"time"

	"github.com/mockzilla/mockzilla-codegen/pkg/runtime"
)

type Cat struct{}

// Pet is one of Cat, Float or Nested.
type Pet struct {
	Cat    *Cat     `json:"-"`
	Float  *float64 `json:"-"`
	Nested *string  `json:"-"`
}

// MarshalJSON writes the variant that is set.
func (p Pet) MarshalJSON() ([]byte, error) {
	var set []any
	if p.Cat != nil {
		set = append(set, p.Cat)
	}
	if p.Float != nil {
		set = append(set, p.Float)
	}
	if p.Nested != nil {
		set = append(set, p.Nested)
	}
	return runtime.MarshalOneOf(nil, set...)
}

// UnmarshalJSON sets the variant data matches.
func (p *Pet) UnmarshalJSON(data []byte) error {
	*p = Pet{}
	return runtime.UnmarshalUnion(data, p.union())
}

// UnmarshalForm sets the variant the form matches.
func (p *Pet) UnmarshalForm(form *multipart.Form) error {
	*p = Pet{}
	return runtime.UnmarshalUnionForm(form, nil, p.union())
}

func (p *Pet) union() runtime.Union {
	return runtime.Union{
		Variants: []runtime.Variant{
			{
				Name:     "Cat",
				Kind:     runtime.KindObject,
				Required: []string{"meow"},
				Known:    []string{"meow", "name"},
				Into:     runtime.Into(&p.Cat),
			},
			{
				Name: "Float",
				Kind: runtime.KindInteger | runtime.KindNumber,
				Into: runtime.Into(&p.Float),
			},
			{
				Name: "Nested",
				Kind: runtime.KindObject,
				Shapes: []runtime.Shape{
					{
						Required: []string{"a"},
						Known:    []string{"a", "b"},
					},
					{
						Known:    []string{},
						IsClosed: true,
					},
					{},
				},
				Into: runtime.Into(&p.Nested),
			},
		},
	}
}

// Stamp is any of Time, Any or Loop, or null.
type Stamp struct {
	Time *time.Time `json:"-"`
	Any  any        `json:"-"`
	Loop *string    `json:"-"`
}

// MarshalJSON writes the variants that are set, merged.
func (s Stamp) MarshalJSON() ([]byte, error) {
	var set []any
	if s.Time != nil {
		set = append(set, s.Time)
	}
	if s.Any != nil {
		set = append(set, s.Any)
	}
	if s.Loop != nil {
		set = append(set, s.Loop)
	}
	return runtime.MarshalUnion(nil, set...)
}

// UnmarshalJSON sets every variant data matches.
func (s *Stamp) UnmarshalJSON(data []byte) error {
	*s = Stamp{}
	return runtime.UnmarshalUnion(data, runtime.Union{
		IsAnyOf: true,
		Variants: []runtime.Variant{
			{
				Name: "Time",
				Kind: runtime.KindString,
				Into: runtime.Into(&s.Time),
			},
			{
				Name: "Any",
				Kind: runtime.KindAny,
				Into: runtime.Into(&s.Any),
			},
			{
				Name: "Loop",
				Kind: runtime.KindAny,
				Into: runtime.Into(&s.Loop),
			},
		},
	})
}

// ID is one of Int or String.
type ID struct {
	Int    *int    `json:"-"`
	String *string `json:"-"`
}

// MarshalJSON writes the variant that is set.
func (i ID) MarshalJSON() ([]byte, error) {
	var set []any
	if i.Int != nil {
		set = append(set, i.Int)
	}
	if i.String != nil {
		set = append(set, i.String)
	}
	return runtime.MarshalOneOf(nil, set...)
}

// UnmarshalJSON sets the variant data matches.
func (i *ID) UnmarshalJSON(data []byte) error {
	*i = ID{}
	return runtime.UnmarshalUnion(data, runtime.Union{
		Variants: []runtime.Variant{
			{
				Name: "Int",
				Kind: runtime.KindInteger,
				Into: runtime.Into(&i.Int),
			},
			{
				Name: "String",
				Kind: runtime.KindString,
				Into: runtime.Into(&i.String),
			},
		},
	})
}

// MarshalText writes the variant that is set as text.
func (i ID) MarshalText() ([]byte, error) {
	return runtime.MarshalUnionText(i.MarshalJSON())
}

// UnmarshalText sets the variant text matches.
func (i *ID) UnmarshalText(text []byte) error {
	return runtime.UnmarshalUnionText(text, i.UnmarshalJSON)
}

// A contact.
type Contact struct {
	ID    string  `json:"id"`
	Email *string `json:"-"`
	Other *string `json:"-"`
}

// MarshalJSON writes the variant that is set, with the discriminator value that picks it.
func (c Contact) MarshalJSON() ([]byte, error) {
	type plain Contact
	return runtime.MarshalVariants(plain(c), c.union(), c.Email, c.Other)
}

// UnmarshalJSON sets the variant data matches, and the shared properties.
func (c *Contact) UnmarshalJSON(data []byte) error {
	*c = Contact{}
	type plain Contact
	if err := json.Unmarshal(data, (*plain)(c)); err != nil {
		return err
	}
	return runtime.UnmarshalUnion(data, c.union())
}

// UnmarshalForm sets the variant the form matches, and the shared properties.
func (c *Contact) UnmarshalForm(form *multipart.Form) error {
	*c = Contact{}
	type plain Contact
	return runtime.UnmarshalUnionForm(form, (*plain)(c), c.union())
}

func (c *Contact) union() runtime.Union {
	return runtime.Union{
		Discriminator: "kind",
		Shared:        []string{"id", "kind"},
		Variants: []runtime.Variant{
			{
				Name:     "Email",
				Kind:     runtime.KindObject,
				Values:   []string{"email", "mail"},
				Known:    []string{},
				IsClosed: true,
				Into:     runtime.Into(&c.Email),
			},
			{
				Name:      "Other",
				Kind:      runtime.KindObject,
				IsDefault: true,
				Into:      runtime.Into(&c.Other),
			},
		},
	}
}

// Person is any of Name.
type Person struct {
	Kind string  `json:"kind"`
	Name *string `json:"-"`
}

// MarshalJSON writes the variants that are set, with the discriminator value that picks them.
func (p Person) MarshalJSON() ([]byte, error) {
	type plain Person
	return runtime.MarshalVariants(plain(p), p.union(), p.Name)
}

// UnmarshalJSON sets every variant data matches, and the shared properties.
func (p *Person) UnmarshalJSON(data []byte) error {
	*p = Person{}
	type plain Person
	if err := json.Unmarshal(data, (*plain)(p)); err != nil {
		return err
	}
	return runtime.UnmarshalUnion(data, p.union())
}

func (p *Person) union() runtime.Union {
	return runtime.Union{
		IsAnyOf:       true,
		Discriminator: "kind",
		Shared:        []string{"kind"},
		Variants: []runtime.Variant{
			{
				Name: "Name",
				Kind: runtime.KindString,
				Into: runtime.Into(&p.Name),
			},
		},
	}
}

// Reminder is one of Email or Phone, and any of Daily or Weekly.
type Reminder struct {
	ID     string  `json:"id"`
	Email  *string `json:"-"`
	Phone  *string `json:"-"`
	Daily  *string `json:"-"`
	Weekly *string `json:"-"`
}

// MarshalJSON writes the variants that are set, merged with the shared properties.
func (r Reminder) MarshalJSON() ([]byte, error) {
	type plain Reminder
	return runtime.MarshalVariants(plain(r), r.union(), r.Email, r.Phone, r.Daily, r.Weekly)
}

// UnmarshalJSON sets the variants of each union data matches, and the shared properties.
func (r *Reminder) UnmarshalJSON(data []byte) error {
	*r = Reminder{}
	type plain Reminder
	if err := json.Unmarshal(data, (*plain)(r)); err != nil {
		return err
	}
	return runtime.UnmarshalUnion(data, r.union())
}

func (r *Reminder) union() runtime.Union {
	return runtime.Union{
		Shared: []string{"id", "every"},
		Variants: []runtime.Variant{
			{
				Name:     "Email",
				Kind:     runtime.KindObject,
				Required: []string{"address"},
				Into:     runtime.Into(&r.Email),
			},
			{
				Name:     "Phone",
				Kind:     runtime.KindObject,
				Required: []string{"number"},
				Into:     runtime.Into(&r.Phone),
			},
		},
		Also: []runtime.Union{
			{
				IsAnyOf:       true,
				Discriminator: "every",
				Variants: []runtime.Variant{
					{
						Name:   "Daily",
						Kind:   runtime.KindObject,
						Values: []string{"day"},
						Into:   runtime.Into(&r.Daily),
					},
					{
						Name:   "Weekly",
						Kind:   runtime.KindObject,
						Values: []string{"week"},
						Into:   runtime.Into(&r.Weekly),
					},
				},
			},
		},
	}
}
