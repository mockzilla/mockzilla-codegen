{{- if or .Counts .Discriminator .Checks .VariantChecks}}
	var errs {{.Validation}}.Errors
{{- range .Counts}}
	errs.Append("", {{.}})
{{- end}}
{{- with .Discriminator}}
	errs.Append("", {{.}})
{{- end}}
{{- range .Checks}}
{{- template "models/check.tmpl" .}}
{{- end}}
{{- range .VariantChecks}}
	var {{.Errs}} {{$.Validation}}.Errors
{{- template "models/check.tmpl" .}}
{{- end}}
{{- range .AnyValid}}
	errs.Append("", {{$.Validation}}.AnyValid(
{{- range .}}
		{{$.Validation}}.VariantErrors{IsSet: {{.IsSet}}{{with .Check}}, Errs: {{.Errs}}{{end}}},
{{- end}}
	))
{{- end}}
	return errs.Err()
{{- else}}
	return nil
{{- end}}