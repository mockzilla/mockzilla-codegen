{{- if or .Count .Discriminator .Checks}}
	var errs {{.Runtime}}.ValidationErrors
{{- with .Count}}
	errs.Append("", {{.}})
{{- end}}
{{- with .Discriminator}}
	errs.Append("", {{.}})
{{- end}}
{{- range .Checks}}
{{- template "models/check.tmpl" .}}
{{- end}}
	return errs.Err()
{{- else}}
	return nil
{{- end}}