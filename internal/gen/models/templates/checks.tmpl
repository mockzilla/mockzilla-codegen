{{- if or .Count .Discriminator .Checks .Variants}}
	var errs {{.Validation}}.Errors
{{- with .Count}}
	errs.Append("", {{.}})
{{- end}}
{{- with .Discriminator}}
	errs.Append("", {{.}})
{{- end}}
{{- range .Checks}}
{{- template "models/check.tmpl" .}}
{{- end}}
{{- range .Variants}}
{{- with .Check}}
	var {{.Errs}} {{$.Validation}}.Errors
{{- template "models/check.tmpl" .}}
{{- end}}
{{- end}}
{{- with .Variants}}
	errs.Append("", {{$.Validation}}.AnyValid(
{{- range .}}
		{{$.Validation}}.VariantErrors{IsSet: {{.IsSet}}{{with .Check}}, Errs: {{.Errs}}{{end}}},
{{- end}}
	))
{{- end}}
	return errs.Err()
{{- else}}
	return nil
{{- end}}