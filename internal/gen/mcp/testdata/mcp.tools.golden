// of its input.
func (t *MCPTools) NoteTool() *mcp.Tool {
	return &mcp.Tool{
		Name:        "note",
		Description: "POST /note",
		InputSchema: json.RawMessage(`{"type":"object","properties":{"body":{"type":"string"}},"additionalProperties":false}`),
		Annotations: &mcp.ToolAnnotations{ReadOnlyHint: false, IdempotentHint: false},
	}
}

// Note handles the note tool: it calls Note of the client and answers with the text it returns.
// An error of the client is the error of the tool, with the body of a response outside 2xx.
func (t *MCPTools) Note(ctx context.Context, _ *mcp.CallToolRequest, in types.NoteToolInput) (*mcp.CallToolResult, any, error) {
	opts := &types.NoteRequestOptions{
		Body: in.Body,
	}
	out, err := t.client.Note(ctx, opts)
	if err != nil {
		return nil, nil, runtime.ToolError(err)
	}
	if out == nil {
		return &mcp.CallToolResult{Content: []mcp.Content{&mcp.TextContent{Text: "ok"}}}, nil, nil
	}
	return &mcp.CallToolResult{Content: []mcp.Content{&mcp.TextContent{Text: string(*out)}}}, nil, nil
}

// UploadTool is the definition of the upload tool: its name, its description and the schema
// of its input.
func (t *MCPTools) UploadTool() *mcp.Tool {
	return &mcp.Tool{
		Name:        "upload",
		Description: "POST /upload",
		InputSchema: json.RawMessage(`{"type":"object","properties":{"body":{"type":"string","contentEncoding":"base64"}},"additionalProperties":false}`),
		Annotations: &mcp.ToolAnnotations{ReadOnlyHint: false, IdempotentHint: false},
	}
}

// Upload handles the upload tool: it calls Upload of the client and answers with the file it returns, as image or audio content when it is one.
// An error of the client is the error of the tool, with the body of a response outside 2xx.
func (t *MCPTools) Upload(ctx context.Context, _ *mcp.CallToolRequest, in types.UploadToolInput) (*mcp.CallToolResult, any, error) {
	opts := &types.UploadRequestOptions{
		BodyMultipart: in.Body,
	}
	out, err := t.client.Upload(ctx, opts)
	if err != nil {
		return nil, nil, runtime.ToolError(err)
	}
	return t.fileResult(runtime.NewFile(out, "", "image/png"))
}

// PhotoTool is the definition of the photo tool: its name, its description and the schema
// of its input.
func (t *MCPTools) PhotoTool() *mcp.Tool {
	return &mcp.Tool{
		Name:        "photo",
		Description: "The photo",
		InputSchema: json.RawMessage(`{"type":"object","additionalProperties":false}`),
		Annotations: &mcp.ToolAnnotations{ReadOnlyHint: true, IdempotentHint: true},
	}
}

// Photo handles the photo tool: it calls Photo of the client and answers with the file it returns, as image or audio content when it is one.
// An error of the client is the error of the tool, with the body of a response outside 2xx.
func (t *MCPTools) Photo(ctx context.Context, _ *mcp.CallToolRequest, _ types.PhotoToolInput) (*mcp.CallToolResult, any, error) {
	opts := &types.PhotoRequestOptions{}
	out, err := t.client.Photo(ctx, opts)
	if err != nil {
		return nil, nil, runtime.ToolError(err)
	}
	if out == nil {
		return &mcp.CallToolResult{Content: []mcp.Content{&mcp.TextContent{Text: "ok"}}}, nil, nil
	}
	return t.fileResult(*out)
}

// TailTool is the definition of the tail tool: its name, its description and the schema
// of its input.
func (t *MCPTools) TailTool() *mcp.Tool {
	return &mcp.Tool{
		Name:        "tail",
		Description: "GET /tail",
		InputSchema: json.RawMessage(`{"type":"object","additionalProperties":false}`),
		Annotations: &mcp.ToolAnnotations{ReadOnlyHint: true, IdempotentHint: true},
	}
}

// Tail handles the tail tool. Tail answers with a stream, so it is ErrMCPStreaming.
func (t *MCPTools) Tail(_ context.Context, _ *mcp.CallToolRequest, _ types.TailToolInput) (*mcp.CallToolResult, any, error) {
	return nil, nil, ErrMCPStreaming
}

// fileResult answers with the bytes of f: as image or audio content when its media type is one,
// else as structured content in base64.
func (*MCPTools) fileResult(f runtime.File) (*mcp.CallToolResult, any, error) {
	data, err := f.Bytes()
	if err != nil {
		return nil, nil, err
	}

	mediaType := f.ContentType()
	switch {
	case strings.HasPrefix(mediaType, "image/"):
		return &mcp.CallToolResult{Content: []mcp.Content{&mcp.ImageContent{Data: data, MIMEType: mediaType}}}, nil, nil
	case strings.HasPrefix(mediaType, "audio/"):
		return &mcp.CallToolResult{Content: []mcp.Content{&mcp.AudioContent{Data: data, MIMEType: mediaType}}}, nil, nil
	}
	return nil, runtime.ToolResult{Value: data}, nil
}
