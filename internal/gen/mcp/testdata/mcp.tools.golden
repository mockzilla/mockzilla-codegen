func (t *MCPTools) DeletePet(ctx context.Context, _ *mcp.CallToolRequest, _ types.DeletePetToolInput) (*mcp.CallToolResult, any, error) {
	opts := &types.DeletePetRequestOptions{}
	if err := t.client.DeletePet(ctx, opts); err != nil {
		return nil, nil, runtime.ToolError(err)
	}
	return &mcp.CallToolResult{Content: []mcp.Content{&mcp.TextContent{Text: "ok"}}}, nil, nil
}

