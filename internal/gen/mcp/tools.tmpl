{{- if .HasStream -}}
// ErrMCPStreaming is what the tool of a streaming operation returns.
var ErrMCPStreaming = {{.Errors}}.New("the operation answers with a stream, which an MCP tool cannot return")

{{end -}}
// MCPTools exposes the operations of the API as MCP tools.
type MCPTools struct {
	client {{.Client}}
}

// NewMCPTools returns the tools that call c. A nil c panics.
func NewMCPTools(c {{.Client}}) *MCPTools {
	if c == nil {
		panic("NewMCPTools: nil client")
	}
	return &MCPTools{client: c}
}

// Register adds every tool to s.
func (t *MCPTools) Register(s *{{.MCP}}.Server) {
{{- range .Tools}}
	{{$.MCP}}.AddTool(s, t.{{.Name}}Tool(), t.{{.Name}})
{{- end}}
}
{{- range .Tools}}

// {{.Name}}Tool is the definition of the {{.Tool}} tool.
func (t *MCPTools) {{.Name}}Tool() *{{$.MCP}}.Tool {
	return &{{$.MCP}}.Tool{
		Name: {{quote .Tool}},
{{- with .Description}}
		Description: {{quote .}},
{{- end}}
		InputSchema: {{$.JSON}}.RawMessage({{.Schema}}),
		Annotations: &{{$.MCP}}.ToolAnnotations{ReadOnlyHint: {{.IsReadOnly}}, IdempotentHint: {{.IsIdempotent}}},
	}
}
{{- if .IsStream}}

// {{.Name}} handles the {{.Tool}} tool.
func (t *MCPTools) {{.Name}}(_ {{$.Context}}.Context, _ *{{$.MCP}}.CallToolRequest, _ {{.Input}}) (*{{$.MCP}}.CallToolResult, any, error) {
	return nil, nil, ErrMCPStreaming
}
{{- else}}

// {{.Name}} handles the {{.Tool}} tool.
func (t *MCPTools) {{.Name}}(ctx {{$.Context}}.Context, {{if .IsRounded}}req{{else}}_{{end}} *{{$.MCP}}.CallToolRequest, {{if .HasInput}}in{{else}}_{{end}} {{.Input}}) (*{{$.MCP}}.CallToolResult, any, error) {
{{- if .IsRounded}}
	if err := {{$.Runtime}}.ToolInput(req.Params.Arguments, &in); err != nil {
		return nil, nil, err
	}
{{end}}
	opts := &{{.Options}}{
{{- range .Groups}}
		{{.Field}}: &{{.Type}}{
{{- range .Assigns}}
			{{.Field}}: in.{{.From}},
{{- end}}
		},
{{- end}}
{{- with .Body}}
		{{.Field}}: in.{{.From}},
{{- end}}
	}
{{- if not .HasResult}}
	if err := t.client.{{.Name}}(ctx, opts); err != nil {
		return nil, nil, {{$.Runtime}}.ToolError(err)
	}
	return &{{$.MCP}}.CallToolResult{Content: []{{$.MCP}}.Content{&{{$.MCP}}.TextContent{Text: "ok"}}}, nil, nil
{{- else}}
	out, err := t.client.{{.Name}}(ctx, opts)
	if err != nil {
		return nil, nil, {{$.Runtime}}.ToolError(err)
	}
{{- if .HasNilCheck}}
	if out == nil {
		return &{{$.MCP}}.CallToolResult{Content: []{{$.MCP}}.Content{&{{$.MCP}}.TextContent{Text: "ok"}}}, nil, nil
	}
{{- end}}
{{- if .Text}}
	return &{{$.MCP}}.CallToolResult{Content: []{{$.MCP}}.Content{&{{$.MCP}}.TextContent{Text: {{.Text}}}}}, nil, nil
{{- else if .File}}
	return t.fileResult({{.File}})
{{- else}}
	return nil, {{$.Runtime}}.ToolResult{Value: out}, nil
{{- end}}
{{- end}}
}
{{- end}}
{{- end}}
{{- if .HasFile}}

func (*MCPTools) fileResult(f {{.Runtime}}.File) (*{{.MCP}}.CallToolResult, any, error) {
	data, err := f.Bytes()
	if err != nil {
		return nil, nil, err
	}

	mediaType := f.ContentType()
	switch {
	case {{.Strings}}.HasPrefix(mediaType, "image/"):
		return &{{.MCP}}.CallToolResult{Content: []{{.MCP}}.Content{&{{.MCP}}.ImageContent{Data: data, MIMEType: mediaType}}}, nil, nil
	case {{.Strings}}.HasPrefix(mediaType, "audio/"):
		return &{{.MCP}}.CallToolResult{Content: []{{.MCP}}.Content{&{{.MCP}}.AudioContent{Data: data, MIMEType: mediaType}}}, nil, nil
	}
	return nil, {{.Runtime}}.ToolResult{Value: data}, nil
}
{{- end}}
