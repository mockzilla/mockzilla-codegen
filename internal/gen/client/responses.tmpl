{{- range .Operations}}
// {{.Type}} is what {{.Name}}WithResponse returns: the response with its body read, and the body
// decoded into the field of its status and media type.{{if .HasStream}} {{.Name}}StreamWithResponse leaves the
// body of a streamed response unread, in the stream field.{{end}}
type {{.Type}} struct {
	HTTPResponse *{{$.HTTP}}.Response
	Body         []byte
{{- range .Fields}}
{{comment .Doc}}
	{{.Name}} {{.Type}}
{{- end}}
}

// StatusCode is the status of the response.
func (r *{{.Type}}) StatusCode() int {
	return r.HTTPResponse.StatusCode
}
{{- end}}