// HTTPDoer sends a request, as *http.Client does.
type HTTPDoer = {{.Runtime}}.Doer

// RequestEditor changes a request before it is sent, to add credentials for one.
type RequestEditor func(ctx {{.Context}}.Context, req *{{.HTTP}}.Request) error

{{with override "client.interface-header" .Header}}{{.}}

{{end}}// {{.Interface}} is what {{.Name}} implements: one method per operation, so a test double can
// stand in for the client.
type {{.Interface}} interface {
{{- range .Signatures}}
	// {{.Name}} calls {{.Route}}.
{{- with .Doc}}
	//
{{comment .}}
{{- end}}
	{{.Name}}(ctx {{$.Context}}.Context, opts *{{.Options}}, editors ...RequestEditor) ({{with .Result}}{{.}}, {{end}}error)
{{- if $.HasEnvelopes}}
	{{.Name}}WithResponse(ctx {{$.Context}}.Context, opts *{{.Options}}, editors ...RequestEditor) (*{{.Response}}, error)
{{- end}}
{{- if .StreamType}}
	{{.Name}}Stream(ctx {{$.Context}}.Context, opts *{{.Options}}, editors ...RequestEditor) ({{.StreamType}}, error)
{{- if $.HasEnvelopes}}
	{{.Name}}StreamWithResponse(ctx {{$.Context}}.Context, opts *{{.Options}}, editors ...RequestEditor) (*{{.Response}}, error)
{{- end}}
{{- end}}
{{- end}}
}

var _ {{.Interface}} = (*{{.Name}})(nil)

// {{.Option}} sets one setting of {{.Name}}.
type {{.Option}} func(*{{.Name}})

// WithHTTPClient sends the requests with d, such as an http.Client set up for the API. A nil d
// panics.
func WithHTTPClient(d HTTPDoer) {{.Option}} {
	if d == nil {
		panic("WithHTTPClient: nil HTTPDoer")
	}
	return func(c *{{.Name}}) {
		c.doer = d
	}
}

// WithTimeout sets how long a call may take, 0 for no limit.
{{- if .HasStreams}} A Stream method waits that long for
// the response headers only, then reads frames until the server ends the stream or the context
// is canceled. An http.Client with a Timeout cuts the stream after it.
{{- end}}
func WithTimeout(d {{.Time}}.Duration) {{.Option}} {
	return func(c *{{.Name}}) {
		c.timeout = d
	}
}

// WithRequestEditor runs fns on every request before it is sent, after any editor added before
// and before the editors of the call. A nil editor panics.
func WithRequestEditor(fns ...RequestEditor) {{.Option}} {
	for _, fn := range fns {
		if fn == nil {
			panic("WithRequestEditor: nil RequestEditor")
		}
	}
	return func(c *{{.Name}}) {
		c.editors = append(c.editors, fns...)
	}
}

// {{.Name}} calls the API at a base URL, with one method per operation.
type {{.Name}} struct {
	baseURL *{{.URL}}.URL
	doer    HTTPDoer
	timeout {{.Time}}.Duration
	editors []RequestEditor
}

// New{{.Name}} returns a client of the API at baseURL. It sends with an http.Client unless
// WithHTTPClient sets another. {{if .Timeout}}A call gives up after {{.Timeout}} unless WithTimeout
// sets another limit.{{else}}A call has no time limit unless WithTimeout sets one.{{end}}
func New{{.Name}}(baseURL string, opts ...{{.Option}}) (*{{.Name}}, error) {
	u, err := {{.Runtime}}.ParseBaseURL(baseURL)
	if err != nil {
		return nil, err
	}

	c := &{{.Name}}{baseURL: u, doer: &{{.HTTP}}.Client{}{{with .Timeout}}, timeout: {{.}}{{end}}}
	for _, opt := range opts {
		opt(c)
	}
	return c, nil
}
