{{- range $op := .Operations}}

// {{.Name}} calls {{.Route}}.
//
{{- with .Doc}}
{{comment .}}
//
{{- end}}
{{- if .Success}}
// It returns the body of a {{.Success}} response. A response outside 2xx, or a 2xx the spec does
// not list, comes back as a *runtime.APIError, wrapping the error type of its status when the spec
// documents one.
{{- else}}
// A response outside 2xx comes back as a *runtime.APIError, wrapping the error type of its status
// when the spec documents one.
{{- end}}
func (c *{{$.Client}}) {{.Name}}(ctx {{$.Context}}.Context, opts *{{.Options}}, editors ...RequestEditor) ({{with .Result}}{{.}}, {{end}}error) {
	req, err := c.{{.Name}}Request(ctx, opts, editors...)
	if err != nil {
		return {{with .Zero}}{{.}}, {{end}}err
	}
	res, body, err := {{$.Runtime}}.Send(c.doer, req, c.timeout)
	if err != nil {
		return {{with .Zero}}{{.}}, {{end}}err
	}
{{- if .Result}}

	var out {{.Result}}
	if err = {{$.Runtime}}.DecodeSuccess(res, body, []{{$.Runtime}}.Target{
{{- template "client/targets.tmpl" .Targets}}
	}); err != nil {
		return {{.Zero}}, err
	}
	return out, nil
{{- else if .Targets}}
	return {{$.Runtime}}.DecodeSuccess(res, body, []{{$.Runtime}}.Target{
{{- template "client/targets.tmpl" .Targets}}
	})
{{- else}}
	return {{$.Runtime}}.DecodeSuccess(res, body, nil)
{{- end}}
}
{{- if $.HasEnvelopes}}

// {{.Name}}WithResponse is {{.Name}} with the whole response: its status, its headers, its raw
// body, and the body decoded into the field of its status and media type. A status outside 2xx is
// no error here. A body or header that does not decode is an error, returned with the response.
func (c *{{$.Client}}) {{.Name}}WithResponse(ctx {{$.Context}}.Context, opts *{{.Options}}, editors ...RequestEditor) (*{{.Response}}, error) {
	req, err := c.{{.Name}}Request(ctx, opts, editors...)
	if err != nil {
		return nil, err
	}
	res, body, err := {{$.Runtime}}.Send(c.doer, req, c.timeout)
	if err != nil {
		return nil, err
	}

	out := &{{.Response}}{HTTPResponse: res, Body: body}
{{- if .EnvelopeTargets}}
	if err = {{$.Runtime}}.Decode(res, body, []{{$.Runtime}}.Target{
{{- template "client/targets.tmpl" .EnvelopeTargets}}
	}); err != nil {
		return out, err
	}
{{- end}}
	return out, nil
}
{{- end}}
{{- if .Stream}}

// {{.Name}}Stream is {{.Name}} over a live stream: it asks for {{.Stream.MediaType}} and returns the
// frames of a 2xx response in a sequential media type as they arrive. The caller closes the stream.
// Any other 2xx response is runtime.ErrContentType; a response outside 2xx is a *runtime.APIError,
// as with {{.Name}}.
func (c *{{$.Client}}) {{.Name}}Stream(ctx {{$.Context}}.Context, opts *{{.Options}}, editors ...RequestEditor) ({{.StreamType}}, error) {
	req, err := c.{{.Name}}Request(ctx, opts, editors...)
	if err != nil {
		return nil, err
	}
	res, body, err := {{$.Runtime}}.SendStream(c.doer, req, {{quote .Stream.MediaType}}, c.timeout)
	if err != nil {
		return nil, err
	}
{{- if .Stream.Targets}}
	return {{$.Runtime}}.OpenStream[{{.Stream.Frame}}](res, body, []{{$.Runtime}}.Target{
{{- template "client/targets.tmpl" .Stream.Targets}}
	})
{{- else}}
	return {{$.Runtime}}.OpenStream[{{.Stream.Frame}}](res, body, nil)
{{- end}}
}
{{- if $.HasEnvelopes}}

// {{.Name}}StreamWithResponse is {{.Name}}WithResponse over a live stream: it asks for
// {{.Stream.MediaType}}, and a 2xx response in a sequential media type comes back with {{.Stream.Field}}
// set, Body nil and HTTPResponse.Body open until the stream is closed. Any other response is read
// and decoded as {{.Name}}WithResponse reads it. An error is returned with the response.
func (c *{{$.Client}}) {{.Name}}StreamWithResponse(ctx {{$.Context}}.Context, opts *{{.Options}}, editors ...RequestEditor) (*{{.Response}}, error) {
	req, err := c.{{.Name}}Request(ctx, opts, editors...)
	if err != nil {
		return nil, err
	}
	res, body, err := {{$.Runtime}}.SendStream(c.doer, req, {{quote .Stream.MediaType}}, c.timeout)
	if err != nil {
		return nil, err
	}

	out := &{{.Response}}{HTTPResponse: res, Body: body}
{{- if .EnvelopeTargets}}
	out.{{.Stream.Field}}, err = {{$.Runtime}}.DecodeStream[{{.Stream.Frame}}](res, body, []{{$.Runtime}}.Target{
{{- template "client/targets.tmpl" .EnvelopeTargets}}
	})
	if err != nil {
		return out, err
	}
{{- else}}
	if {{$.Runtime}}.IsStreaming(res) {
		out.{{.Stream.Field}} = {{$.Runtime}}.NewStream[{{.Stream.Frame}}](res)
	}
{{- end}}
	return out, nil
}
{{- end}}
{{- end}}

// {{.Name}}Request builds the request of {{.Route}} and runs the editors of the client on it, then
// editors.
func (c *{{$.Client}}) {{.Name}}Request(ctx {{$.Context}}.Context, opts *{{.Options}}, editors ...RequestEditor) (*{{$.HTTP}}.Request, error) {
	if opts == nil {
		opts = &{{.Options}}{}
	}
{{- if .IsSendable}}
	b := {{$.Runtime}}.NewRequestBuilder({{.Method}}, {{.Path}})
{{- range .Groups}}
	if opts.{{.Field}} != nil {
{{- range .Params}}
		b.{{.Encoder}}({{.Value}}, {{$.Runtime}}.Param{Name: {{.Name}}, Style: {{$.Runtime}}.{{.Style}}, IsExplode: {{.IsExplode}}, IsRequired: {{.IsRequired}}, IsJSON: {{.IsJSON}}})
{{- end}}
	}
{{- end}}
{{- end}}
{{- if .Bodies}}
	switch {
{{- range .Bodies}}
	case {{.IsSet}}:
{{- if .Encoder}}
		b.{{.Encoder}}({{.Value}}{{with .MediaType}}, {{.}}{{end}})
{{- else}}
		return nil, {{$.Runtime}}.ContentTypeError({{.MediaType}})
{{- end}}
{{- end}}
{{- if .IsBodyRequired}}
	default:
		return nil, {{$.Runtime}}.ErrBodyEmpty
{{- end}}
	}
{{- end}}
{{- if .IsSendable}}
	return c.newRequest(ctx, b, editors)
{{- end}}
}
{{- end}}
{{- if .Operations}}

// newRequest builds b against the base URL and runs the editors of the client on the request, then
// editors.
func (c *{{.Client}}) newRequest(ctx {{.Context}}.Context, b *{{.Runtime}}.RequestBuilder, editors []RequestEditor) (*{{.HTTP}}.Request, error) {
	req, err := b.Build(ctx, c.baseURL)
	if err != nil {
		return nil, err
	}
	for _, edit := range {{.Slices}}.Concat(c.editors, editors) {
		if err = edit(ctx, req); err != nil {
			return nil, err
		}
	}
	return req, nil
}
{{- end}}
