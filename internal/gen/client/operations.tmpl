// {{.Interface}} is what {{.Client}} implements: one method per operation, so a test double can
// stand in for the client.
type {{.Interface}} interface {
{{- range .Operations}}
{{- with .Doc}}
{{comment .}}
{{- end}}
	{{.Name}}(ctx {{$.Context}}.Context, opts *{{.Options}}) ({{with .Result}}{{.}}, {{end}}error)
{{- if $.HasEnvelopes}}
	{{.Name}}WithResponse(ctx {{$.Context}}.Context, opts *{{.Options}}) (*{{.Response}}, error)
{{- end}}
{{- end}}
}

var _ {{.Interface}} = (*{{.Client}})(nil)
{{- range $op := .Operations}}

// {{.Name}}Request builds the request of {{.Name}}, with the editors of the client applied.
func (c *{{$.Client}}) {{.Name}}Request(ctx {{$.Context}}.Context, opts *{{.Options}}) (*{{$.HTTP}}.Request, error) {
	if opts == nil {
		opts = &{{.Options}}{}
	}
	b := {{$.Runtime}}.NewRequestBuilder({{.Method}}, {{.Path}})
{{- range .Groups}}
	if opts.{{.Field}} != nil {
{{- range .Params}}
		b.{{.Encoder}}({{.Value}}, {{$.Runtime}}.Param{Name: {{.Name}}, Style: {{$.Runtime}}.{{.Style}}, IsExplode: {{.IsExplode}}, IsRequired: {{.IsRequired}}, IsJSON: {{.IsJSON}}})
{{- end}}
	}
{{- end}}
{{- if .Bodies}}
	switch {
{{- range .Bodies}}
	case {{.IsSet}}:
{{- if .Encoder}}
		b.{{.Encoder}}({{.Value}}{{with .MediaType}}, {{.}}{{end}})
{{- else}}
		return nil, {{$.Runtime}}.ContentTypeError({{.MediaType}})
{{- end}}
{{- end}}
{{- if .IsBodyRequired}}
	default:
		return nil, {{$.Runtime}}.ErrBodyEmpty
{{- end}}
	}
{{- end}}
	return c.newRequest(ctx, b)
}
{{with .Doc}}
{{comment .}}
