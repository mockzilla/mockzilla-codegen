{{- range .Operations}}
// {{.Type}} is what {{.Name}} sends.
type {{.Type}} struct {
{{- range .Fields}}
{{- with .Doc}}
{{comment .}}
{{- end}}
	{{.Name}} {{.Type}}
{{- end}}
}

// Validate checks the parameters and the body against the constraints of the spec.
func (o *{{.Type}}) Validate() error {
{{- if .Checks}}
	var errs {{.Validation}}.Errors
{{- range .Checks}}
	if o.{{.Field}} != nil {
		errs.Append({{.Path}}, o.{{.Field}}.Validate())
	}
{{- end}}
	return errs.Err()
{{- else}}
	return nil
{{- end}}
}
{{- end}}