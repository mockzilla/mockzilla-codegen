{{- range $op := .Operations}}

// {{.Name}} calls {{.Route}}.
{{- with .Doc}}
//
{{comment .}}
{{- end}}
func (c *{{$.Client}}) {{.Name}}(ctx {{$.Context}}.Context, opts *{{.Options}}, editors ...RequestEditor) ({{with .Result}}{{.}}, {{end}}error) {
	req, err := c.{{.Name}}Request(ctx, opts, editors...)
	if err != nil {
		return {{with .Zero}}{{.}}, {{end}}err
	}
	res, body, err := {{$.Runtime}}.Send(c.doer, req, {{.Accept}}, c.timeout)
	if err != nil {
		return {{with .Zero}}{{.}}, {{end}}err
	}
{{- if .Result}}

	var out {{.Result}}
	if err = {{$.Runtime}}.DecodeSuccess(res, body, []{{$.Runtime}}.Target{
{{- template "client/targets.tmpl" .Targets}}
	}); err != nil {
		return {{.Zero}}, err
	}
	return out, nil
{{- else if .Targets}}
	return {{$.Runtime}}.DecodeSuccess(res, body, []{{$.Runtime}}.Target{
{{- template "client/targets.tmpl" .Targets}}
	})
{{- else}}
	return {{$.Runtime}}.DecodeSuccess(res, body, nil)
{{- end}}
}
{{- if $.HasEnvelopes}}

// {{.Name}}WithResponse calls {{.Route}} and returns the whole response.
func (c *{{$.Client}}) {{.Name}}WithResponse(ctx {{$.Context}}.Context, opts *{{.Options}}, editors ...RequestEditor) (*{{.Response}}, error) {
	req, err := c.{{.Name}}Request(ctx, opts, editors...)
	if err != nil {
		return nil, err
	}
	res, body, err := {{$.Runtime}}.Send(c.doer, req, {{.Accept}}, c.timeout)
	if err != nil {
		return nil, err
	}

	out := &{{.Response}}{HTTPResponse: res, Body: body}
{{- if .EnvelopeTargets}}
	if err = {{$.Runtime}}.Decode(res, body, []{{$.Runtime}}.Target{
{{- template "client/targets.tmpl" .EnvelopeTargets}}
	}); err != nil {
		return out, err
	}
{{- end}}
	return out, nil
}
{{- end}}
{{- if .Stream}}

// {{.Name}}Stream calls {{.Route}} and returns its frames as a stream.
func (c *{{$.Client}}) {{.Name}}Stream(ctx {{$.Context}}.Context, opts *{{.Options}}, editors ...RequestEditor) ({{.StreamType}}, error) {
	req, err := c.{{.Name}}Request(ctx, opts, editors...)
	if err != nil {
		return nil, err
	}
	res, body, err := {{$.Runtime}}.SendStream(c.doer, req, {{quote .Stream.MediaType}}, c.timeout)
	if err != nil {
		return nil, err
	}
{{- if .Stream.Targets}}
	return {{$.Runtime}}.OpenStream[{{.Stream.Frame}}](res, body, []{{$.Runtime}}.Target{
{{- template "client/targets.tmpl" .Stream.Targets}}
	})
{{- else}}
	return {{$.Runtime}}.OpenStream[{{.Stream.Frame}}](res, body, nil)
{{- end}}
}
{{- if $.HasEnvelopes}}

// {{.Name}}StreamWithResponse calls {{.Route}} and returns the whole response, with its stream.
func (c *{{$.Client}}) {{.Name}}StreamWithResponse(ctx {{$.Context}}.Context, opts *{{.Options}}, editors ...RequestEditor) (*{{.Response}}, error) {
	req, err := c.{{.Name}}Request(ctx, opts, editors...)
	if err != nil {
		return nil, err
	}
	res, body, err := {{$.Runtime}}.SendStream(c.doer, req, {{quote .Stream.MediaType}}, c.timeout)
	if err != nil {
		return nil, err
	}

	out := &{{.Response}}{HTTPResponse: res, Body: body}
{{- if .EnvelopeTargets}}
	out.{{.Stream.Field}}, err = {{$.Runtime}}.DecodeStream[{{.Stream.Frame}}](res, body, []{{$.Runtime}}.Target{
{{- template "client/targets.tmpl" .EnvelopeTargets}}
	})
	if err != nil {
		return out, err
	}
{{- else}}
	if {{$.Runtime}}.IsStreaming(res) {
		out.{{.Stream.Field}} = {{$.Runtime}}.NewStream[{{.Stream.Frame}}](res)
	}
{{- end}}
	return out, nil
}
{{- end}}
{{- end}}

// {{.Name}}Request builds the request of {{.Route}}.
func (c *{{$.Client}}) {{.Name}}Request(ctx {{$.Context}}.Context, opts *{{.Options}}, editors ...RequestEditor) (*{{$.HTTP}}.Request, error) {
	if opts == nil {
		opts = &{{.Options}}{}
	}
{{- if .IsSendable}}
	b := {{$.Runtime}}.NewRequestBuilder({{.Method}}, {{.Path}})
{{- range .Groups}}
	if opts.{{.Field}} != nil {
{{- range .Params}}
		b.{{.Encoder}}({{.Value}}, {{$.Runtime}}.Param{Name: {{.Name}}, Style: {{$.Runtime}}.{{.Style}}, IsExplode: {{.IsExplode}}, IsRequired: {{.IsRequired}}, IsJSON: {{.IsJSON}}})
{{- end}}
	}
{{- end}}
{{- with .QueryString}}
	b.QueryString({{.Value}}, {{$.Runtime}}.Param{Name: {{.Name}}, IsRequired: {{.IsRequired}}, IsJSON: {{.IsJSON}}})
{{- end}}
{{- end}}
{{- if .Bodies}}
	switch {
{{- range .Bodies}}
	case {{.IsSet}}:
{{- if .Encoder}}
		b.{{.Encoder}}({{.Value}}{{with .MediaType}}, {{.}}{{end}}{{with .Encoding}}, {{.}}{{end}})
{{- else}}
		return nil, {{$.Runtime}}.ContentTypeError({{.MediaType}})
{{- end}}
{{- end}}
{{- if .IsBodyRequired}}
	default:
		return nil, {{$.Runtime}}.ErrBodyEmpty
{{- end}}
	}
{{- end}}
{{- if .IsSendable}}
	return c.newRequest(ctx, {{quote .Name}}, b, editors)
{{- end}}
}
{{- end}}
{{- if .Operations}}

func (c *{{.Client}}) newRequest(ctx {{.Context}}.Context, id string, b *{{.Runtime}}.RequestBuilder, editors []RequestEditor) (*{{.HTTP}}.Request, error) {
	ctx = {{.Runtime}}.WithOperationID(ctx, id)
	req, err := b.Build(ctx, c.baseURL)
	if err != nil {
		return nil, err
	}
	for _, edit := range {{.Slices}}.Concat(c.editors, editors) {
		if err = edit(ctx, req); err != nil {
			return nil, err
		}
	}
	return req, nil
}
{{- end}}
