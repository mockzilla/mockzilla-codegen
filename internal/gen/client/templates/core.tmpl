// HTTPDoer sends a request, as *http.Client does.
type HTTPDoer = {{.HTTPClient}}.Doer

// RequestEditor changes a request before it is sent.
type RequestEditor func(ctx {{.Context}}.Context, req *{{.HTTP}}.Request) error

{{with override "client.interface-header" .Header}}{{.}}

{{end}}// {{.Interface}} is what {{.Name}} implements.
type {{.Interface}} interface {
{{- range .Signatures}}
	// {{.Name}} calls {{.Route}}.
{{- with .Doc}}
	//
{{comment .}}
{{- end}}
	{{.Name}}(ctx {{$.Context}}.Context, opts *{{.Options}}, editors ...RequestEditor) ({{with .Result}}{{.}}, {{end}}error)
{{- if $.HasEnvelopes}}
	{{.Name}}WithResponse(ctx {{$.Context}}.Context, opts *{{.Options}}, editors ...RequestEditor) (*{{.Response}}, error)
{{- end}}
{{- if .StreamType}}
	{{.Name}}Stream(ctx {{$.Context}}.Context, opts *{{.Options}}, editors ...RequestEditor) ({{.StreamType}}, error)
{{- if $.HasEnvelopes}}
	{{.Name}}StreamWithResponse(ctx {{$.Context}}.Context, opts *{{.Options}}, editors ...RequestEditor) (*{{.Response}}, error)
{{- end}}
{{- end}}
{{- end}}
}

var _ {{.Interface}} = (*{{.Name}})(nil)

// {{.Option}} sets one setting of {{.Name}}.
type {{.Option}} func(*{{.Name}})

// WithHTTPClient sends the requests with d. A nil d panics.
func WithHTTPClient(d HTTPDoer) {{.Option}} {
	if d == nil {
		panic("WithHTTPClient: nil HTTPDoer")
	}
	return func(c *{{.Name}}) {
		c.doer = d
	}
}

// WithTimeout sets how long a call may take, 0 for no limit.
{{- if .HasStreams}}
// A Stream method waits that long for the response headers only.
{{- end}}
func WithTimeout(d {{.Time}}.Duration) {{.Option}} {
	return func(c *{{.Name}}) {
		c.timeout = d
	}
}

// WithRequestEditor runs fns on every request before it is sent. A nil one panics.
func WithRequestEditor(fns ...RequestEditor) {{.Option}} {
	for _, fn := range fns {
		if fn == nil {
			panic("WithRequestEditor: nil RequestEditor")
		}
	}
	return func(c *{{.Name}}) {
		c.editors = append(c.editors, fns...)
	}
}

// {{.Name}} calls the API at a base URL.
// A response outside 2xx, or a 2xx the spec does not list, is a *{{.HTTPClient}}.APIError.
type {{.Name}} struct {
	baseURL *{{.URL}}.URL
	doer    HTTPDoer
	timeout {{.Time}}.Duration
	editors []RequestEditor
}

// New{{.Name}} returns a client of the API at baseURL.
func New{{.Name}}(baseURL string, opts ...{{.Option}}) (*{{.Name}}, error) {
	u, err := {{.HTTPClient}}.ParseBaseURL(baseURL)
	if err != nil {
		return nil, err
	}

	c := &{{.Name}}{baseURL: u, doer: &{{.HTTP}}.Client{}{{with .Timeout}}, timeout: {{.}}{{end}}}
	for _, opt := range opts {
		opt(c)
	}
	return c, nil
}
