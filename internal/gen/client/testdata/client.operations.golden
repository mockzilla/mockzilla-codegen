		b.MultipartBody(opts.BodyMultipart, nil)
	case opts.BodyText != "":
		b.TextBody(opts.BodyText, "text/plain")
	case opts.BodyMarkdown != nil:
		b.TextBody(string(*opts.BodyMarkdown), "text/markdown")
