// ListPets calls GET /pets.
//
// # List pets
//
// Returns pets.
func (c *PetClient) ListPets(ctx context.Context, opts *types.ListPetsRequestOptions, editors ...RequestEditor) (types.Pets, error) {
	req, err := c.ListPetsRequest(ctx, opts, editors...)
	if err != nil {
		return nil, err
	}
	res, body, err := runtime.Send(c.doer, req, "application/json, application/xml", c.timeout)
	if err != nil {
		return nil, err
	}

	var out types.Pets
	if err = runtime.DecodeSuccess(res, body, []runtime.Target{
		{Status: "200", MediaType: "application/json", Dst: &out},
		{Status: "default", MediaType: "application/json", Dst: new(types.Problem)},
	}); err != nil {
		return nil, err
	}
	return out, nil
}

// ListPetsRequest builds the request of GET /pets.
func (c *PetClient) ListPetsRequest(ctx context.Context, opts *types.ListPetsRequestOptions, editors ...RequestEditor) (*http.Request, error) {
	if opts == nil {
		opts = &types.ListPetsRequestOptions{}
	}
	b := runtime.NewRequestBuilder(http.MethodGet, "/pets")
	if opts.Query != nil {
		b.QueryParam(opts.Query.Limit, runtime.Param{Name: "limit", Style: runtime.StyleForm, IsExplode: true, IsRequired: false, IsJSON: false})
		b.QueryParam(opts.Query.Filter, runtime.Param{Name: "filter", Style: runtime.StyleDeepObject, IsExplode: true, IsRequired: true, IsJSON: false})
	}
	if opts.Headers != nil {
		b.HeaderParam(opts.Headers.XTrace, runtime.Param{Name: "X-Trace", Style: runtime.StyleSimple, IsExplode: false, IsRequired: false, IsJSON: true})
	}
	if opts.Cookies != nil {
		b.CookieParam(opts.Cookies.Session, runtime.Param{Name: "session", Style: runtime.StyleForm, IsExplode: false, IsRequired: true, IsJSON: false})
	}
	return c.newRequest(ctx, "ListPets", b, editors)
}

