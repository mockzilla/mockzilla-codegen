// CreatePetRequest builds the request of POST /pets.
func (c *PetClient) CreatePetRequest(ctx context.Context, opts *types.CreatePetRequestOptions, editors ...RequestEditor) (*http.Request, error) {
	if opts == nil {
		opts = &types.CreatePetRequestOptions{}
	}
	b := runtime.NewRequestBuilder(http.MethodPost, "/pets")
	switch {
	case opts.BodyJSON != nil:
		b.JSONBody(opts.BodyJSON, "application/json")
	case opts.BodyForm != nil:
		b.FormBody(opts.BodyForm, nil)
	case opts.BodyMultipart != nil:
		b.MultipartBody(opts.BodyMultipart, nil)
	case opts.BodyText != "":
		b.TextBody(opts.BodyText, "text/plain")
	case opts.BodyMarkdown != nil:
		b.TextBody(string(*opts.BodyMarkdown), "text/markdown")
	case opts.BodyPng != nil:
		b.BytesBody(opts.BodyPng, "image/png")
	case opts.BodyJpeg != nil:
		b.FileBody(*opts.BodyJpeg, "image/jpeg")
	case opts.BodyXML != nil:
		return nil, runtime.ContentTypeError("application/xml")
	default:
		return nil, runtime.ErrBodyEmpty
	}
	return c.newRequest(ctx, "CreatePet", b, editors)
}

