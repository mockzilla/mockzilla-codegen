package types

import "net/http"

// ListPetsResponse is what ListPetsWithResponse returns: the response with its body read, and the body
// decoded into the field of its status and media type.
type ListPetsResponse struct {
	HTTPResponse *http.Response
	Body         []byte
	// XML200 is the body of a 200 response as application/xml.
	XML200 *string
	// JSON200 is the body of a 200 response as application/json.
	JSON200 Pets
	// JSONDefault is the body of a default response as application/json.
	JSONDefault *Problem
	// Headers200 holds the headers the spec declares for a 200 response.
	Headers200 *ListPetsResponse200Headers
	// HeadersDefault holds the headers the spec declares for a default response.
	HeadersDefault *ListPetsResponseDefaultHeaders
}

// StatusCode is the status of the response.
func (r *ListPetsResponse) StatusCode() int {
	return r.HTTPResponse.StatusCode
}

// CreatePetResponse is what CreatePetWithResponse returns: the response with its body read, and the body
// decoded into the field of its status and media type.
type CreatePetResponse struct {
	HTTPResponse *http.Response
	Body         []byte
	// JSON202 is the body of a 202 response as application/json.
	JSON202 *Note
	// JSON201 is the body of a 201 response as application/json.
	JSON201 *Pet
	// JSON409 is the body of a 409 response as application/json.
	JSON409 *Locked
	// ProblemJSON4XX is the body of a 4XX response as application/problem+json.
	ProblemJSON4XX *Failure
	// ProblemJSON5XX is the body of a 5XX response as application/problem+json.
	ProblemJSON5XX *Problem
	// Headers201 holds the headers the spec declares for a 201 response.
	Headers201 *ListPetsResponse200Headers
}

// StatusCode is the status of the response.
func (r *CreatePetResponse) StatusCode() int {
	return r.HTTPResponse.StatusCode
}

