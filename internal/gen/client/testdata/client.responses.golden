// ListPetsResponse is what ListPetsWithResponse returns.
type ListPetsResponse struct {
	HTTPResponse *http.Response
	Body         []byte
	// XML200 is the body of a 200 response as application/xml.
	XML200 *string
	// JSON200 is the body of a 200 response as application/json.
	JSON200 Pets
	// JSONDefault is the body of a default response as application/json.
	JSONDefault *Problem
	// Headers200 holds the headers the spec declares for a 200 response.
	Headers200 *ListPetsResponse200Headers
	// HeadersDefault holds the headers the spec declares for a default response.
	HeadersDefault *ListPetsResponseDefaultHeaders
}

// StatusCode is the status of the response.
func (r *ListPetsResponse) StatusCode() int {
	return r.HTTPResponse.StatusCode
}

