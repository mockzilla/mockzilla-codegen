package api

import (
	"context"
	"encoding/json"
	"net/http"
	"net/url"
	"time"

	"example.com/work/types"
	"github.com/mockzilla/mockzilla-codegen/pkg/runtime/httpclient"
)

// HTTPDoer sends a request, as *http.Client does.
type HTTPDoer = httpclient.Doer

// RequestEditor changes a request before it is sent.
type RequestEditor func(ctx context.Context, req *http.Request) error

// PetClientInterface is what PetClient implements.
type PetClientInterface interface {
	// ListPets calls GET /pets.
	// List pets
	// Returns pets.
	ListPets(ctx context.Context, opts *types.ListPetsRequestOptions, editors ...RequestEditor) (types.Pets, error)
	ListPetsWithResponse(ctx context.Context, opts *types.ListPetsRequestOptions, editors ...RequestEditor) (*types.ListPetsResponse, error)
	// CreatePet calls POST /pets.
	// Same
	//
	// Deprecated: the spec marks it deprecated.
	CreatePet(ctx context.Context, opts *types.CreatePetRequestOptions, editors ...RequestEditor) (*types.Pet, error)
	CreatePetWithResponse(ctx context.Context, opts *types.CreatePetRequestOptions, editors ...RequestEditor) (*types.CreatePetResponse, error)
	// DeletePet calls DELETE /pets/{id}.
	//
	// Deprecated: the spec marks it deprecated.
	DeletePet(ctx context.Context, opts *types.DeletePetRequestOptions, editors ...RequestEditor) error
	DeletePetWithResponse(ctx context.Context, opts *types.DeletePetRequestOptions, editors ...RequestEditor) (*types.DeletePetResponse, error)
	// Ping calls GET /ping.
	Ping(ctx context.Context, opts *types.PingRequestOptions, editors ...RequestEditor) (string, error)
	PingWithResponse(ctx context.Context, opts *types.PingRequestOptions, editors ...RequestEditor) (*types.PingResponse, error)
	// Query calls QUERY /pets/query.
	Query(ctx context.Context, opts *types.QueryRequestOptions, editors ...RequestEditor) error
	QueryWithResponse(ctx context.Context, opts *types.QueryRequestOptions, editors ...RequestEditor) (*types.QueryResponse, error)
	// Chat calls POST /chat.
	Chat(ctx context.Context, opts *types.ChatRequestOptions, editors ...RequestEditor) (*types.Pet, error)
	ChatWithResponse(ctx context.Context, opts *types.ChatRequestOptions, editors ...RequestEditor) (*types.ChatResponse, error)
	ChatStream(ctx context.Context, opts *types.ChatRequestOptions, editors ...RequestEditor) (*httpclient.Stream[types.ChatResponseItem], error)
	ChatStreamWithResponse(ctx context.Context, opts *types.ChatRequestOptions, editors ...RequestEditor) (*types.ChatResponse, error)
	// Tail calls GET /tail.
	Tail(ctx context.Context, opts *types.TailRequestOptions, editors ...RequestEditor) (*string, error)
	TailWithResponse(ctx context.Context, opts *types.TailRequestOptions, editors ...RequestEditor) (*types.TailResponse, error)
	TailStream(ctx context.Context, opts *types.TailRequestOptions, editors ...RequestEditor) (*httpclient.Stream[[]byte], error)
	TailStreamWithResponse(ctx context.Context, opts *types.TailRequestOptions, editors ...RequestEditor) (*types.TailResponse, error)
}

var _ PetClientInterface = (*PetClient)(nil)

// PetClientOption sets one setting of PetClient.
type PetClientOption func(*PetClient)

// WithHTTPClient sends the requests with d. A nil d panics.
func WithHTTPClient(d HTTPDoer) PetClientOption {
	if d == nil {
		panic("WithHTTPClient: nil HTTPDoer")
	}
	return func(c *PetClient) {
		c.doer = d
	}
}

// WithTimeout sets how long a call may take, 0 for no limit.
// A Stream method waits that long for the response headers only.
func WithTimeout(d time.Duration) PetClientOption {
	return func(c *PetClient) {
		c.timeout = d
	}
}

// WithRequestEditor runs fns on every request before it is sent. A nil one panics.
func WithRequestEditor(fns ...RequestEditor) PetClientOption {
	for _, fn := range fns {
		if fn == nil {
			panic("WithRequestEditor: nil RequestEditor")
		}
	}
	return func(c *PetClient) {
		c.editors = append(c.editors, fns...)
	}
}

// WithJSON writes JSON bodies with marshal and reads them with unmarshal. A nil one panics.
func WithJSON(marshal func(v any) ([]byte, error), unmarshal func(data []byte, v any) error) PetClientOption {
	if marshal == nil || unmarshal == nil {
		panic("WithJSON: nil function")
	}
	return func(c *PetClient) {
		c.marshal, c.unmarshal = marshal, unmarshal
	}
}

// PetClient calls the API at a base URL.
// A response outside 2xx, or a 2xx the spec does not list, is a *httpclient.APIError.
type PetClient struct {
	baseURL   *url.URL
	doer      HTTPDoer
	timeout   time.Duration
	editors   []RequestEditor
	marshal   func(v any) ([]byte, error)
	unmarshal func(data []byte, v any) error
}

// NewPetClient returns a client of the API at baseURL.
func NewPetClient(baseURL string, opts ...PetClientOption) (*PetClient, error) {
	u, err := httpclient.ParseBaseURL(baseURL)
	if err != nil {
		return nil, err
	}

	c := &PetClient{
		baseURL:   u,
		doer:      &http.Client{},
		timeout:   5 * time.Second,
		marshal:   json.Marshal,
		unmarshal: json.Unmarshal,
	}
	for _, opt := range opts {
		opt(c)
	}
	return c, nil
}
