openapi: 3.1.0
info:
  title: split
  version: '1'
  description: "  indented first line\nsecond line"
paths:
  /pets:
    get:
      responses:
        '200':
          description: ok
          content:
            application/json:
              schema: {$ref: '#/components/schemas/pet'}
      operationId: listPets
components:
  schemas:
    pet:
      type: object
      properties:
        name: {type: string}
      x-go-name: Animal
