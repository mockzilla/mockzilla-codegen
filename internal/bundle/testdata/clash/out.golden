openapi: 3.0.3
info: {title: clash, version: '1'}
paths:
  /pets:
    get:
      responses:
        '200':
          description: ok
          content:
            application/json:
              schema:
                type: object
                properties:
                  a: {$ref: '#/components/schemas/PetA'}
                  b: {$ref: '#/components/schemas/PetB'}
                  again: {$ref: '#/components/schemas/PetB'}
                  deep: {$ref: '#/components/schemas/Pet2'}
                  common: {$ref: '#/components/schemas/PetCommon'}
                  err: {$ref: '#/components/schemas/ErrorCommon'}
components:
  schemas:
    Pet: {type: string}
    PetX: {type: string}
    Error: {type: string}
    PetA:
      type: integer
    PetB:
      type: boolean
    Pet2:
      type: number
    PetCommon: {type: array, items: {type: string}}
    ErrorCommon: {type: object}
# grafted
