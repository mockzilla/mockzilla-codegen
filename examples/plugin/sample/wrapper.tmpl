{{- $context := import "context"}}
// withBodies sets GenerateResponse on the options of an operation, then calls the service.
type withBodies struct {
	svc {{expr .Service}}
}

// WithBodies returns svc with GenerateResponse set on the options of every operation.
func WithBodies(svc {{expr .Service}}) {{expr .Service}} {
	return &withBodies{svc: svc}
}
{{- range .Calls}}

func (s *withBodies) {{.ID}}(ctx {{$context}}.Context, opts *{{expr .Options}}) (*{{expr .Data}}, error) {
	opts.GenerateResponse = func() (*{{expr .Data}}, error) {
{{- if .HasBody}}
		return &{{expr .Data}}{Status: {{status .ID}}, Body: Bodies[{{quote .ID}}]()}, nil
{{- else}}
		return &{{expr .Data}}{Status: {{status .ID}}}, nil
{{- end}}
	}
	return s.svc.{{.ID}}(ctx, opts)
}
{{- end}}
